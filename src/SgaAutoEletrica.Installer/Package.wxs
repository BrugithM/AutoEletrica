<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package
      Name="SGA AutoElétrica"
      Manufacturer="AutoElétrica Sistemas"
      Version="1.0.0"
      UpgradeCode="8B5A3C2D-1E4F-4A9B-8C7D-6E5F4A3B2C1D"
      Language="1046"
      Codepage="1252"
      InstallerVersion="500"
      Compressed="yes">

    <MajorUpgrade
        AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="Uma versão mais recente do SGA AutoElétrica já está instalada." />

    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="SgaAutoEletrica" />
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DataFolder" Name="SgaAutoEletrica">
        <Directory Id="DataSubFolder" Name="Data" />
        <Directory Id="ConfigSubFolder" Name="Config" />
        <Directory Id="BackupsSubFolder" Name="Backups" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="ProgramFiles" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="A1B2C3D4-E5F6-4A7B-8C9D-0E1F2A3B4C5D">
        <File Id="SgaAutoEletricaUI.exe"
              Source="..\publish\SgaAutoEletrica.UI.exe"
              KeyPath="yes" />
      </Component>

      <Component Id="OtherPublishFiles" Guid="B2C3D4E5-F6A7-4B8C-9D0E-1F2A3B4C5D6E">
        <File Id="SgaAutoEletricaUI.pdb"
              Source="..\publish\SgaAutoEletrica.UI.pdb"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="DataFolders" Directory="DataSubFolder">
      <Component Id="DataFolderComponent" Guid="C3D4E5F6-A7B8-4C9D-0E1F-2A3B4C5D6E7F">
        <CreateFolder />
        <RegistryValue Root="HKLM"
                       Key="Software\SgaAutoEletrica"
                       Name="DataFolder"
                       Type="string"
                       Value="[DataSubFolder]"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="ConfigFolders" Directory="ConfigSubFolder">
      <Component Id="ConfigFolderComponent" Guid="D4E5F6A7-B8C9-4D0E-1F2A-3B4C5D6E7F8A">
        <CreateFolder />
        <RegistryValue Root="HKLM"
                       Key="Software\SgaAutoEletrica"
                       Name="ConfigFolder"
                       Type="string"
                       Value="[ConfigSubFolder]"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="BackupsFolders" Directory="BackupsSubFolder">
      <Component Id="BackupsFolderComponent" Guid="E5F6A7B8-C9D0-4E1F-2A3B-4C5D6E7F8A9B">
        <CreateFolder />
        <RegistryValue Root="HKLM"
                       Key="Software\SgaAutoEletrica"
                       Name="BackupsFolder"
                       Type="string"
                       Value="[BackupsSubFolder]"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="Shortcuts" Directory="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="F6A7B8C9-D0E1-4F2A-3B4C-5D6E7F8A9B0C">
        <Shortcut Id="StartMenuLink"
                  Name="SGA AutoElétrica"
                  Description="Sistema de Gestão para Autoelétrica"
                  Target="[INSTALLFOLDER]SgaAutoEletrica.UI.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveStartMenu" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\SgaAutoEletrica"
                       Name="StartMenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="MainFeature" Title="SGA AutoElétrica" Level="1">
      <ComponentGroupRef Id="ProgramFiles" />
      <ComponentGroupRef Id="DataFolders" />
      <ComponentGroupRef Id="ConfigFolders" />
      <ComponentGroupRef Id="BackupsFolders" />
      <ComponentGroupRef Id="Shortcuts" />
    </Feature>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

  </Package>
</Wix>