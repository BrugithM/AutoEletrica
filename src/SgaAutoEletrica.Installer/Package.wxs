<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package
      Name="SGA AutoElétrica"
      Manufacturer="AutoElétrica Sistemas"
      Version="1.0.0"
      UpgradeCode="8B5A3C2D-1E4F-4A9B-8C7D-6E5F4A3B2C1D"
      Language="1046"
      Codepage="65001"
      InstallerVersion="500"
      Compressed="yes"
      Scope="perMachine">

    <WixVariable Id="WixUILicenseRtf" Value="TermosDeUso.rtf" />

    <Icon Id="AppIcon.ico" SourceFile="icon.ico" />

    <MajorUpgrade
        AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="Uma versão mais recente do SGA AutoElétrica já está instalada." />

    <MediaTemplate EmbedCab="yes" />

    <!-- Estrutura de diretórios -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="SgaAutoEletrica" />
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DataRootFolder" Name="SgaAutoEletrica">
        <Directory Id="DataFolder" Name="Data" />
        <Directory Id="ConfigFolder" Name="Config" />
        <Directory Id="LogsFolder" Name="Logs" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppShortcutFolder" Name="SGA AutoElétrica" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <!-- Arquivos do programa -->
    <ComponentGroup Id="ProgramFiles" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable"
                 Guid="A1B2C3D4-E5F6-4A7B-8C9D-0E1F2A3B4C5D">
        <File Id="SgaAutoEletricaUI.exe"
              Source="..\publish\SgaAutoEletrica.UI.exe"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Pasta Data -->
    <ComponentGroup Id="DataFolderGroup" Directory="DataFolder">
      <Component Id="DataFolderComponent"
                 Guid="C3D4E5F6-A7B8-4C9D-0E1F-2A3B4C5D6E7F">
        <CreateFolder>
          <util:PermissionEx User="Users"
                             GenericAll="yes"
                             Delete="yes"
                             Read="yes" />
        </CreateFolder>
        <RegistryValue Root="HKLM"
                       Key="Software\SgaAutoEletrica"
                       Name="DataFolder"
                       Type="string"
                       Value="[DataFolder]"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Pasta Config -->
    <ComponentGroup Id="ConfigFolderGroup" Directory="ConfigFolder">
      <Component Id="ConfigFolderComponent"
                 Guid="D4E5F6A7-B8C9-4D0E-1F2A-3B4C5D6E7F8A">
        <CreateFolder>
          <util:PermissionEx User="Users"
                             GenericAll="yes"
                             Delete="yes"
                             Read="yes" />
        </CreateFolder>
        <RegistryValue Root="HKLM"
                       Key="Software\SgaAutoEletrica"
                       Name="ConfigFolder"
                       Type="string"
                       Value="[ConfigFolder]"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Pasta Logs -->
    <ComponentGroup Id="LogsFolderGroup" Directory="LogsFolder">
      <Component Id="LogsFolderComponent"
                 Guid="E5F6A7B8-C9D0-4E1F-2A3B-4C5D6E7F8A9B">
        <CreateFolder>
          <util:PermissionEx User="Users"
                             GenericAll="yes"
                             Delete="yes"
                             Read="yes" />
        </CreateFolder>
        <RegistryValue Root="HKLM"
                       Key="Software\SgaAutoEletrica"
                       Name="LogsFolder"
                       Type="string"
                       Value="[LogsFolder]"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Atalho no Menu Iniciar -->
    <ComponentGroup Id="Shortcuts" Directory="AppShortcutFolder">
      <Component Id="StartMenuShortcut"
                 Guid="F6A7B8C9-D0E1-4F2A-3B4C-5D6E7F8A9B0C">
        <Shortcut Id="StartMenuLink"
                  Name="SGA AutoElétrica"
                  Description="Sistema de Gestão para Autoelétrica"
                  Target="[INSTALLFOLDER]SgaAutoEletrica.UI.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon.ico" />
        <RemoveFolder Id="RemoveAppShortcutFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\SgaAutoEletrica"
                       Name="StartMenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Atalho na Área de Trabalho -->
    <ComponentGroup Id="DesktopShortcuts" Directory="DesktopFolder">
      <Component Id="DesktopShortcut"
                 Guid="A7B8C9D0-E1F2-4A3B-4C5D-6E7F8A9B0C1D">
        <Shortcut Id="DesktopLink"
                  Name="SGA AutoElétrica"
                  Description="Sistema de Gestão para Autoelétrica"
                  Target="[INSTALLFOLDER]SgaAutoEletrica.UI.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon.ico" />
        <RemoveFolder Id="RemoveDesktopShortcutFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\SgaAutoEletrica"
                       Name="DesktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Feature principal -->
    <Feature Id="MainFeature" Title="SGA AutoElétrica" Level="1">
      <ComponentGroupRef Id="ProgramFiles" />
      <ComponentGroupRef Id="DataFolderGroup" />
      <ComponentGroupRef Id="ConfigFolderGroup" />
      <ComponentGroupRef Id="LogsFolderGroup" />
      <ComponentGroupRef Id="Shortcuts" />
      <ComponentGroupRef Id="DesktopShortcuts" />
    </Feature>

    <!-- Interface do instalador -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

  </Package>
</Wix>