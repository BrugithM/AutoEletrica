<Window x:Class="SgaAutoEletrica.UI.Views.MarcasVeiculo.ListaMarcasVeiculoView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gerenciar Marcas de Veículos" Height="500" Width="600" 
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="➕ Nova" Command="{Binding NovaMarcaCommand}" Width="80" Margin="0,0,5,0" Style="{StaticResource BotaoToolbarStyle}"/>
            <Button Content="✏️ Editar" Command="{Binding EditarMarcaCommand}" Width="80" Margin="0,0,5,0" Style="{StaticResource BotaoToolbarStyle}"/>
            <Button Content="{Binding TextoBotaoDesativar}" Command="{Binding DesativarMarcaCommand}" Width="95" Margin="0,0,5,0" Style="{StaticResource BotaoToolbarStyle}"/>
            <Button Content="⟳ Atualizar" Command="{Binding AtualizarCommand}" Width="85" Style="{StaticResource BotaoToolbarStyle}"/>
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Marcas}" SelectedItem="{Binding MarcaSelecionada}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  RowStyle="{StaticResource InativoRowStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Ativo, Converter={StaticResource BoolParaStatusConverter}}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>