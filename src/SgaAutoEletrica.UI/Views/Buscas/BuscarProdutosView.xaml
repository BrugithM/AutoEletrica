<UserControl x:Class="SgaAutoEletrica.UI.Views.Buscas.BuscarProdutosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Buscar Produtos" FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Background="#F5F5F5" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Código de Barras:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtCodigoBarras" 
                                 Text="{Binding CodigoBarras, UpdateSourceTrigger=PropertyChanged}"
                                 Height="30" FontSize="14" Padding="5"
                                 ToolTip="Digite ou escaneie o código de barras (ex: 7891234567890)"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,5,0">
                        <TextBlock Text="Código da Peça:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtCodigoPeca" 
                                 Text="{Binding CodigoPeca, UpdateSourceTrigger=PropertyChanged}"
                                 Height="30" FontSize="14" Padding="5"
                                 ToolTip="Digite o código interno da peça (ex: FR-001)"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Marca:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtMarca" 
                                 Text="{Binding Marca, UpdateSourceTrigger=PropertyChanged}"
                                 Height="30" FontSize="14" Padding="5"
                                 ToolTip="Digite a marca (ex: Cobreq, Bosch, Mann)"/>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <TextBlock Text="Dica: preencha um ou mais campos e clique em Buscar. Todos os filtros são combináveis."
                               FontSize="11" Foreground="#666" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <Button Content="Limpar" Command="{Binding LimparCommand}"
                            Width="80" Height="30" Margin="0,0,10,0"/>
                    <Button Content="Buscar" Command="{Binding BuscarCommand}"
                            Width="100" Height="30" Background="#3498DB" Foreground="White" FontWeight="SemiBold"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Resultados}" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID Peça" Binding="{Binding IdPeca}" Width="90"/>
                <DataGridTextColumn Header="Código" Binding="{Binding CodigoPeca}" Width="80"/>
                <DataGridTextColumn Header="Código Barras" Binding="{Binding CodigoBarras}" Width="120"/>
                <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="200"/>
                <DataGridTextColumn Header="Marca" Binding="{Binding Marca}" Width="100"/>
                <DataGridTextColumn Header="Categoria" Binding="{Binding CategoriaNome}" Width="100"/>
                <DataGridTextColumn Header="Valor" Binding="{Binding ValorVenda, StringFormat=C2}" Width="80"/>
                <DataGridTextColumn Header="Estoque" Binding="{Binding Estoque}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>