<UserControl x:Class="SgaAutoEletrica.UI.Views.Buscas.BuscarNotasEntradaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barra de Ferramentas -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="➕ Nova NF" Command="{Binding NovaNFCommand}"
                    Width="100" Margin="0,0,5,0" Style="{StaticResource BotaoPadraoStyle}"/>
        </StackPanel>

        <!-- Filtros -->
        <Border Grid.Row="1" Background="#F5F5F5" Padding="10" Margin="0,0,0,10" CornerRadius="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Nome do Fornecedor:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding NomeFornecedor, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="5"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,5,0">
                        <TextBlock Text="CNPJ:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding CnpjFornecedor, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="5"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Código do Produto:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding CodigoProduto, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="5"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Nome do Produto:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding NomeProduto, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="5"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,5,0">
                        <TextBlock Text="Data Início:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <DatePicker SelectedDate="{Binding DataInicio}" Height="28"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Data Fim:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <DatePicker SelectedDate="{Binding DataFim}" Height="28"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="Limpar" Command="{Binding LimparCommand}" Width="80" Margin="0,0,10,0" Style="{StaticResource BotaoPadraoStyle}"/>
                    <Button Content="🔍 Buscar" Command="{Binding BuscarCommand}" Width="100" Style="{StaticResource BotaoPadraoStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Text="Notas Fiscais de Entrada:" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>

        <!-- Grid de NFs -->
        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding Notas}"
                  SelectedItem="{Binding NotaSelecionada}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Número" Binding="{Binding Numero}" Width="120"/>
                <DataGridTextColumn Header="Fornecedor" Binding="{Binding NomeFornecedor}" Width="250"/>
                <DataGridTextColumn Header="CNPJ" Binding="{Binding CnpjFornecedor}" Width="180"/>
                <DataGridTextColumn Header="Data" Binding="{Binding DataEntrada, StringFormat=dd/MM/yyyy}" Width="120"/>
                <DataGridTextColumn Header="Valor" Binding="{Binding ValorTotal, StringFormat=C2}" Width="120"/>
                <DataGridTextColumn Header="Observação" Binding="{Binding Observacao}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Título dos Itens (colapsa quando nada selecionado) -->
        <TextBlock Grid.Row="4" Text="{Binding TituloItens}" FontWeight="Bold" FontSize="14"
                   Margin="0,10,0,5"
                   Visibility="{Binding TemNotaSelecionada, Converter={StaticResource BoolParaVisibilidade}}"/>

        <!-- Grid de Itens -->
        <DataGrid Grid.Row="5"
                  ItemsSource="{Binding ItensNF}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  MaxHeight="180"
                  Visibility="{Binding TemNotaSelecionada, Converter={StaticResource BoolParaVisibilidade}}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Produto" Binding="{Binding NomePeca}" Width="*"/>
                <DataGridTextColumn Header="Qtd" Binding="{Binding Quantidade}" Width="80"/>
                <DataGridTextColumn Header="Valor Unit. (R$)" Binding="{Binding ValorUnitario, StringFormat=C2}" Width="150"/>
                <DataGridTextColumn Header="Subtotal (R$)" Binding="{Binding ValorTotal, StringFormat=C2}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Rodapé com paginação -->
        <Border Grid.Row="6" Background="#DCE7F5" Padding="10,8" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding TextoPaginacao}" 
                           Foreground="Black" VerticalAlignment="Center" FontWeight="SemiBold"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="◀ Anterior" Command="{Binding PaginaAnteriorCommand}"
                            Width="100" Height="24" Margin="0,0,5,0"/>
                    <Button Content="Próxima ▶" Command="{Binding ProximaPaginaCommand}"
                            Width="100" Height="24"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>