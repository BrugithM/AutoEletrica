<UserControl x:Class="SgaAutoEletrica.UI.Views.Buscas.BuscarNotasEmitidasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Buscar Notas Emitidas" FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Background="#F5F5F5" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Placa do Veículo:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding Placa, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="5"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,5,0">
                        <TextBlock Text="Nome do Cliente:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding NomeCliente, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="5"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Peça/Serviço:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding NomePeca, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="5"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Observação:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding Observacao, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="5"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,5,0">
                        <TextBlock Text="Data Início:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <DatePicker SelectedDate="{Binding DataInicio}" Height="30"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Data Fim:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <DatePicker SelectedDate="{Binding DataFim}" Height="30"/>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <TextBlock Text="Busca parcial e não diferencia maiúsculas/minúsculas"
                               FontSize="11" Foreground="#666" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <Button Content="Limpar" Command="{Binding LimparCommand}" Width="80" Height="30" Margin="0,0,10,0"/>
                    <Button Content="Buscar" Command="{Binding BuscarCommand}" Width="100" Height="30" 
                            Background="#3498DB" Foreground="White" FontWeight="SemiBold"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Resultados}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Número" Binding="{Binding Numero}" Width="100"/>
                <DataGridTextColumn Header="Data" Binding="{Binding DataEmissao, StringFormat=dd/MM/yyyy}" Width="90"/>
                <DataGridTextColumn Header="Cliente" Binding="{Binding NomeCliente}" Width="180"/>
                <DataGridTextColumn Header="Placa" Binding="{Binding PlacaVeiculo}" Width="80"/>
                <DataGridTextColumn Header="Valor" Binding="{Binding ValorTotal, StringFormat=C2}" Width="90"/>
                <DataGridTextColumn Header="Observação" Binding="{Binding Observacao}" Width="200"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>