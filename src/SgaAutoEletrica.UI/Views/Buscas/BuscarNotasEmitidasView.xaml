<UserControl x:Class="SgaAutoEletrica.UI.Views.Buscas.BuscarNotasEmitidasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Filtros -->
        <Border Grid.Row="1" Background="#F5F5F5" Padding="10" Margin="0,0,0,10" CornerRadius="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Placa:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding Placa, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="5"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,5,0">
                        <TextBlock Text="Nome do Cliente:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding NomeCliente, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="5"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Peça/Serviço:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding NomePeca, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="5"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Observação:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding Observacao, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="5"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,5,0">
                        <TextBlock Text="Data Início:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <DatePicker SelectedDate="{Binding DataInicio}" Height="28"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Data Fim:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <DatePicker SelectedDate="{Binding DataFim}" Height="28"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="Limpar" Command="{Binding LimparCommand}" Width="80" Height="30" Margin="0,0,10,0"/>
                    <Button Content="🔍 Buscar" Command="{Binding BuscarCommand}" Width="120" Height="30" 
                            Background="#3498DB" Foreground="White" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Text="Notas Fiscais Emitidas:" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>

        <!-- Grid de NFs -->
        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding Notas}"
                  SelectedItem="{Binding NotaSelecionada}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  MouseDoubleClick="DataGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Número" Binding="{Binding Numero}" Width="130"/>
                <DataGridTextColumn Header="Data" Binding="{Binding DataEmissao, StringFormat=dd/MM/yyyy}" Width="110"/>
                <DataGridTextColumn Header="Cliente" Binding="{Binding NomeCliente}" Width="250"/>
                <DataGridTextColumn Header="Placa" Binding="{Binding PlacaVeiculo}" Width="100"/>
                <DataGridTextColumn Header="Valor" Binding="{Binding ValorTotal, StringFormat=C2}" Width="120"/>
                <DataGridTextColumn Header="Observação" Binding="{Binding Observacao}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Rodapé com paginação -->
        <Border Grid.Row="4" Background="#2C3E50" Padding="10,8" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding TextoPaginacao}" 
                           Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="◀ Anterior" Command="{Binding PaginaAnteriorCommand}"
                            Width="100" Height="28" Margin="0,0,5,0"/>
                    <Button Content="Próxima ▶" Command="{Binding ProximaPaginaCommand}"
                            Width="100" Height="28"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>