<Window x:Class="SgaAutoEletrica.UI.Views.Configuracoes.CadastroUsuarioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SgaAutoEletrica.UI.Views.Controls"
        Title="Novo Usuário" Height="350" Width="450"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Novo Usuário" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

            <TextBlock Text="Nome de usuário:" FontWeight="SemiBold"/>
            <TextBox x:Name="TxtNome" Height="28" Margin="0,2,0,15"/>

            <TextBlock Text="Senha (mínimo 6 caracteres):" FontWeight="SemiBold"/>
            <controls:CampoSenha x:Name="TxtSenha" Height="28" Margin="0,2,0,15"/>

            <TextBlock Text="Nível de acesso:" FontWeight="SemiBold"/>
            <ComboBox x:Name="CmbNivel" Height="28" Margin="0,2,0,15" SelectedIndex="1">
                <ComboBoxItem Content="Administrador"/>
                <ComboBoxItem Content="Operador"/>
            </ComboBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="Salvar" Width="80" Margin="0,0,10,0" Style="{StaticResource BotaoPadraoStyle}" Click="BtnSalvar_Click"/>
                <Button Content="Cancelar" Width="80" Style="{StaticResource BotaoPadraoStyle}" Click="BtnCancelar_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>