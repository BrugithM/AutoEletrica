<UserControl x:Class="SgaAutoEletrica.UI.Views.Configuracoes.MeuPerfilView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:controls="clr-namespace:SgaAutoEletrica.UI.Views.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="Meu Perfil"
                    FontSize="22"
                    FontWeight="Bold"
                    Margin="0,0,0,20"/>

            <!-- Dados do usuário -->
            <GroupBox Header="Dados do Usuário"
                    Padding="10"
                    Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="Nome de usuário:"
                            FontWeight="SemiBold"/>
                    <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}"
                             Height="28"
                            Margin="0,2,0,10"/>

                    <TextBlock Text="Nível de acesso:"
                            FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Nivel}"
                            FontSize="14"
                            Margin="0,2,0,10"/>

                    <Button Content="Salvar Nome"
                            Command="{Binding SalvarNomeCommand}"
                            Width="110"
                            HorizontalAlignment="Right"
                            Style="{StaticResource BotaoPadraoStyle}"/>
                </StackPanel>
            </GroupBox>

            <!-- Alterar senha -->
            <GroupBox Header="Alterar Senha"
                    Padding="10">
                <StackPanel>
                    <TextBlock Text="Senha atual:"
                            FontWeight="SemiBold"/>
                    <controls:CampoSenha x:Name="TxtSenhaAtual"
                            Height="28"
                            Margin="0,2,0,10"/>

                    <TextBlock Text="Nova senha (mínimo 6 caracteres):"
                            FontWeight="SemiBold"/>
                    <controls:CampoSenha x:Name="TxtNovaSenha"
                            Height="28"
                            Margin="0,2,0,10"/>

                    <TextBlock Text="Confirmar nova senha:"
                            FontWeight="SemiBold"/>
                    <controls:CampoSenha x:Name="TxtConfirmarNovaSenha"
                            Height="28"
                            Margin="0,2,0,15"/>

                    <Button Content="Alterar Senha"
                            Click="BtnAlterarSenha_Click"
                            HorizontalAlignment="Right"
                            Width="110"
                            Style="{StaticResource BotaoPadraoStyle}"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>