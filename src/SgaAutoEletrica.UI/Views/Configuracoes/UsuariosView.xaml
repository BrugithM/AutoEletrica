<UserControl x:Class="SgaAutoEletrica.UI.Views.Configuracoes.UsuariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        <UserControl.InputBindings>
                <KeyBinding Key="F5"
                            Command="{Binding AtualizarCommand}"/>
        </UserControl.InputBindings>
        <Grid Margin="0">
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Padding="5"
                                Background="#DCE7F5">
                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,10">
                                <Button Content="➕ Novo Usuário"
                                        Command="{Binding NovoUsuarioCommand}"
                                        Width="120"
                                        Style="{StaticResource BotaoToolbarStyle}"/>
                                <Button Content="🔑 Resetar Senha"
                                        Command="{Binding ResetarSenhaCommand}"
                                        Width="110"
                                        Style="{StaticResource BotaoToolbarStyle}"/>
                                <Button Content="⏸️ Desativar"
                                        Command="{Binding DesativarCommand}"
                                        Width="95"
                                        Style="{StaticResource BotaoToolbarStyle}"/>
                                <Button Content="⟳ Atualizar"
                                        Command="{Binding AtualizarCommand}"
                                        Width="85"
                                        Style="{StaticResource BotaoToolbarStyle}"/>
                                <CheckBox Content="Mostrar inativos"
                                          IsChecked="{Binding MostrarInativos}"
                                          VerticalAlignment="Center"
                                          FontWeight="SemiBold"/>
                        </StackPanel>
                </Border>

                <TextBlock Grid.Row="1"
                           Text="Usuários Cadastrados:"
                           FontWeight="Bold"
                           FontSize="14"
                           Margin="10"/>

                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding Usuarios}"
                          SelectedItem="{Binding UsuarioSelecionado}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          Margin="10"
                          RowStyle="{StaticResource InativoRowStyle}"
                          CanUserAddRows="False">
                        <DataGrid.Columns>
                                <DataGridTextColumn Header="Nome"
                                                    Binding="{Binding Nome}"
                                                    Width="200"/>
                                <DataGridTextColumn Header="Nível"
                                                    Binding="{Binding Nivel}"
                                                    Width="130"/>
                                <DataGridTextColumn Header="Status"
                                                    Width="100">
                                        <DataGridTextColumn.Binding>
                                                <Binding Path="Ativo"
                                                         Converter="{StaticResource BoolParaStatusConverter}"/>
                                        </DataGridTextColumn.Binding>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Criado em"
                                                    Binding="{Binding DataCriacao, Converter={StaticResource UtcParaLocal}, StringFormat=dd/MM/yyyy}"
                                                    Width="120"/>
                                <DataGridTextColumn Header="Último login"
                                                    Binding="{Binding UltimoLogin, Converter={StaticResource UtcParaLocal}, StringFormat=dd/MM/yyyy HH:mm}"
                                                    Width="150"/>
                        </DataGrid.Columns>
                </DataGrid>
        </Grid>
</UserControl>