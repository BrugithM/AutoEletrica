<Window x:Class="SgaAutoEletrica.UI.Views.Configuracoes.ResetarSenhaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SgaAutoEletrica.UI.Views.Controls"
        Title="Resetar Senha" Height="250" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Nova senha:" FontWeight="SemiBold"/>
            <controls:CampoSenha x:Name="TxtNovaSenha" Height="28" Margin="0,2,0,15"/>

            <TextBlock Text="Confirmar nova senha:" FontWeight="SemiBold"/>
            <controls:CampoSenha x:Name="TxtConfirmar" Height="28" Margin="0,2,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Resetar" Width="80" Margin="0,0,10,0" Style="{StaticResource BotaoPadraoStyle}" Click="BtnResetar_Click"/>
                <Button Content="Cancelar" Width="80" Style="{StaticResource BotaoPadraoStyle}" Click="BtnCancelar_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>