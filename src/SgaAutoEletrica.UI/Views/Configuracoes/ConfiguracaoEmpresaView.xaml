<UserControl x:Class="SgaAutoEletrica.UI.Views.Configuracoes.ConfiguracaoEmpresaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Configurações da Empresa" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1" Text="Nome da Empresa:" FontWeight="SemiBold" Margin="0,0,0,3"/>
        <TextBox Grid.Row="2" Text="{Binding NomeEmpresa, UpdateSourceTrigger=PropertyChanged}" 
                 Height="30" FontSize="14" Padding="5" Margin="0,0,0,15" MaxLength="200"/>

        <TextBlock Grid.Row="3" Text="CNPJ:" FontWeight="SemiBold" Margin="0,0,0,3"/>
        <TextBox Grid.Row="4" Text="{Binding Cnpj, UpdateSourceTrigger=PropertyChanged}" 
                 Height="30" FontSize="14" Padding="5" Margin="0,0,0,15" MaxLength="18"/>

        <TextBlock Grid.Row="5" Text="Telefone:" FontWeight="SemiBold" Margin="0,0,0,3"/>
        <TextBox Grid.Row="6" Text="{Binding Telefone, UpdateSourceTrigger=PropertyChanged}" 
                 Height="30" FontSize="14" Padding="5" Margin="0,0,0,15" MaxLength="15"/>

        <TextBlock Grid.Row="7" Text="Endereço:" FontWeight="SemiBold" Margin="0,0,0,3"/>
        <TextBox Grid.Row="8" Text="{Binding Endereco, UpdateSourceTrigger=PropertyChanged}" 
                 Height="30" FontSize="14" Padding="5" Margin="0,0,0,15" MaxLength="300"/>

        <TextBlock Grid.Row="9" Text="Email:" FontWeight="SemiBold" Margin="0,0,0,3"/>
        <TextBox Grid.Row="10" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" 
                 Height="30" FontSize="14" Padding="5" Margin="0,0,0,20" MaxLength="100"/>

        <StackPanel Grid.Row="11" HorizontalAlignment="Right">
            <Button Content="Salvar Configurações" Command="{Binding SalvarCommand}"
                    Width="170" Height="35" Background="#27AE60" Foreground="White" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</UserControl>