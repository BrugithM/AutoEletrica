<UserControl x:Class="SgaAutoEletrica.UI.Views.Configuracoes.ConfiguracaoEmpresaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="Configurações da Empresa"
                    FontSize="24"
                    FontWeight="Bold"
                    Margin="0,0,0,20"/>

            <!-- Dados da Empresa -->
            <GroupBox Header="Dados da Empresa"
                    Padding="10"
                    Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="Nome da Empresa:"
                            FontWeight="SemiBold"
                            Margin="0,0,0,3"/>
                    <TextBox Text="{Binding NomeEmpresa, UpdateSourceTrigger=PropertyChanged}"
                             Height="30"
                            Padding="5"
                            Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="CNPJ:"
                                    FontWeight="SemiBold"
                                    Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtCnpj"
                                     Text="{Binding Cnpj, UpdateSourceTrigger=PropertyChanged}"
                                     Height="30"
                                    Padding="5"
                                     LostFocus="TxtCnpj_LostFocus"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Telefone:"
                                    FontWeight="SemiBold"
                                    Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtTelefone"
                                     Text="{Binding Telefone, UpdateSourceTrigger=PropertyChanged}"
                                     Height="30"
                                    Padding="5"
                                     LostFocus="TxtTelefone_LostFocus"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Endereço:"
                            FontWeight="SemiBold"
                            Margin="0,10,0,3"/>
                    <TextBox Text="{Binding Endereco, UpdateSourceTrigger=PropertyChanged}"
                             Height="30"
                            Padding="5"
                            Margin="0,0,0,10"/>

                    <TextBlock Text="Email:"
                            FontWeight="SemiBold"
                            Margin="0,0,0,3"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             Height="30"
                            Padding="5"/>
                </StackPanel>
            </GroupBox>

            <!-- Imagem de Fundo -->
            <GroupBox Header="Imagem de Fundo"
                    Padding="10"
                    Margin="0,0,0,15">
                <StackPanel>
                    <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,10">
                        <Button Content="📁 Selecionar Imagem"
                                Command="{Binding SelecionarImagemCommand}"
                                Width="170"
                                Style="{StaticResource BotaoPadraoStyle}"/>
                        <Button Content="➖ Remover Imagem"
                                Command="{Binding RemoverImagemCommand}"
                                Width="160"
                                Style="{StaticResource BotaoPadraoStyle}"/>
                    </StackPanel>

                    <TextBlock Text="Pré-visualização:"
                            FontWeight="SemiBold"
                            Margin="0,5,0,5"/>

                    <Border BorderBrush="#CCC"
                            BorderThickness="1"
                            Height="250"
                            Background="#FAFAFA"
                            CornerRadius="4">
                        <Grid>
                            <Image Source="{Binding LogoPreview}"
                                   Stretch="Uniform"
                                   Margin="10"
                                   Visibility="{Binding TemLogo, Converter={StaticResource BoolParaVisibilidade}}"/>

                            <TextBlock Text="Nenhuma imagem selecionada"
                                       Foreground="#999"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontStyle="Italic"
                                       Visibility="{Binding TemLogo, Converter={StaticResource InverterBoolParaVisibilidade}}"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </GroupBox>

            <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right">
                <Button Content="Salvar Configurações"
                        Command="{Binding SalvarCommand}"
                        Width="180"
                        Style="{StaticResource BotaoPadraoStyle}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>