<UserControl x:Class="SgaAutoEletrica.UI.Views.Clientes.ListaClientesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        <Grid Margin="0">
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Barra de Ferramentas -->
                <Border Padding="5"
                        Background="#DCE7F5">
                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal">
                                <Button Content="➕ Novo"
                                        Command="{Binding NovoClienteCommand}"
                                        Width="70"
                                        Style="{StaticResource BotaoToolbarStyle}"/>
                                <Button Content="✏️ Editar"
                                        Command="{Binding EditarClienteCommand}"
                                        Width="75"
                                        Style="{StaticResource BotaoToolbarStyle}"/>
                                <Button Content="{Binding TextoBotaoDesativar}"
                                        Command="{Binding DesativarClienteCommand}"
                                        Width="95"
                                        Style="{StaticResource BotaoToolbarStyle}"/>
                                <Button Content="⟳ Atualizar"
                                        Command="{Binding AtualizarCommand}"
                                        Width="85"
                                        Style="{StaticResource BotaoToolbarStyle}"/>
                        </StackPanel>
                </Border>

                <!-- Alternador de modo -->
                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            Margin="10">
                        <Button Content="⌕ Busca Avançada"
                                Command="{Binding AlternarModoBuscaCommand}"
                                Width="160"
                                Style="{StaticResource BotaoPadraoStyle}"/>
                </StackPanel>

                <!-- Busca Rápida -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            Margin="10,0,10,10"
                            Visibility="{Binding ModoBuscaRapida, Converter={StaticResource BoolParaVisibilidade}}">
                        <TextBlock Text="Pesquisar:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,5,0"
                                   FontSize="12"/>
                        <TextBox Text="{Binding TermoBusca, UpdateSourceTrigger=PropertyChanged}"
                                 Width="180"
                                 Height="28"
                                 VerticalContentAlignment="Center"
                                 Padding="4"
                                 Margin="0,0,2,0"
                                 ToolTip="Nome, CPF ou Telefone"/>
                        <Button Content="⌕"
                                Command="{Binding BuscarCommand}"
                                Width="28"
                                Margin="0,0,10,0"
                                Style="{StaticResource BotaoToolbarStyle}"
                                Background="Transparent"
                                />

                        <CheckBox Content="Mostrar inativos"
                                  IsChecked="{Binding MostrarInativos}"
                                  VerticalAlignment="Center"
                                  FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Busca Avançada -->
                <Border Grid.Row="2"
                        Background="#F5F5F5"
                        Padding="10"
                        Margin="10,0,10,10"
                        CornerRadius="5"
                        Visibility="{Binding ModoBuscaAvancada, Converter={StaticResource BoolParaVisibilidade}}">
                        <StackPanel>
                                <Grid>
                                        <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0"
                                                    Margin="0,0,5,0">
                                                <TextBlock Text="Nome:"
                                                           FontWeight="SemiBold"
                                                           Margin="0,0,0,3"/>
                                                <TextBox Text="{Binding BuscaNome, UpdateSourceTrigger=PropertyChanged}"
                                                         Height="28"
                                                         Padding="5"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    Margin="0,0,5,0">
                                                <TextBlock Text="CPF:"
                                                           FontWeight="SemiBold"
                                                           Margin="0,0,0,3"/>
                                                <TextBox Text="{Binding BuscaCpf, UpdateSourceTrigger=PropertyChanged}"
                                                         Height="28"
                                                         Padding="5"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                                <TextBlock Text="Telefone:"
                                                           FontWeight="SemiBold"
                                                           Margin="0,0,0,3"/>
                                                <TextBox Text="{Binding BuscaTelefone, UpdateSourceTrigger=PropertyChanged}"
                                                         Height="28"
                                                         Padding="5"/>
                                        </StackPanel>
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0"
                                                    Margin="0,0,5,0">
                                                <TextBlock Text="Endereço (logradouro, bairro, cidade ou CEP):"
                                                           FontWeight="SemiBold"
                                                           Margin="0,0,0,3"/>
                                                <TextBox Text="{Binding BuscaEndereco, UpdateSourceTrigger=PropertyChanged}"
                                                         Height="28"
                                                         Padding="5"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Bottom">
                                                <CheckBox Content="Mostrar inativos"
                                                          IsChecked="{Binding MostrarInativos}"
                                                          VerticalAlignment="Center"
                                                          FontWeight="SemiBold"
                                                          Margin="0,0,15,0"/>
                                                <Button Content="Limpar"
                                                        Command="{Binding LimparBuscaCommand}"
                                                        Width="80"
                                                        Style="{StaticResource BotaoPadraoStyle}"
                                                        Margin="0,0,10,0"/>
                                                <Button Content="⌕ Buscar"
                                                        Command="{Binding BuscarCommand}"
                                                        Width="120"
                                                        Style="{StaticResource BotaoPadraoStyle}"/>
                                        </StackPanel>
                                </Grid>
                        </StackPanel>
                </Border>

                <!-- Grid de Clientes -->
                <DataGrid Grid.Row="3"
                          ItemsSource="{Binding Clientes}"
                          SelectedItem="{Binding ClienteSelecionado}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          Margin="10"
                          RowStyle="{StaticResource InativoRowStyle}">
                        <DataGrid.Columns>
                                <DataGridTextColumn Header="Nome"
                                                    Binding="{Binding NomeCompleto}"
                                                    Width="250"/>
                                <DataGridTextColumn Header="CPF"
                                                    Binding="{Binding Cpf}"
                                                    Width="140"/>
                                <DataGridTextColumn Header="Telefone"
                                                    Binding="{Binding Telefone}"
                                                    Width="140"/>
                                <DataGridTextColumn Header="Endereço"
                                                    Binding="{Binding EnderecoCompleto}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="Veículos"
                                                    Binding="{Binding QuantidadeVeiculos}"
                                                    Width="70"/>
                        </DataGrid.Columns>
                </DataGrid>

                <!-- Painel de Veículos -->
                <TextBlock Grid.Row="4"
                           Text="Veículos Vinculados:"
                           FontWeight="Bold"
                           FontSize="14"
                           Margin="10,5,10,5"
                           Visibility="{Binding TemClienteSelecionado, Converter={StaticResource BoolParaVisibilidade}}"/>

                <DataGrid Grid.Row="5"
                          ItemsSource="{Binding VeiculosDoCliente}"
                          Visibility="{Binding TemClienteSelecionado, Converter={StaticResource BoolParaVisibilidade}}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          Margin="10"
                          MaxHeight="150">
                        <DataGrid.Columns>
                                <DataGridTextColumn Header="Placa"
                                                    Binding="{Binding Placa}"
                                                    Width="100"/>
                                <DataGridTextColumn Header="Marca"
                                                    Binding="{Binding Marca}"
                                                    Width="120"/>
                                <DataGridTextColumn Header="Modelo"
                                                    Binding="{Binding Modelo}"
                                                    Width="150"/>
                                <DataGridTextColumn Header="Ano"
                                                    Binding="{Binding Ano}"
                                                    Width="70"/>
                                <DataGridTextColumn Header="Cor"
                                                    Binding="{Binding Cor}"
                                                    Width="100"/>
                                <DataGridTextColumn Header="Observação"
                                                    Binding="{Binding Observacao}"
                                                    Width="*"/>
                        </DataGrid.Columns>
                </DataGrid>

                <!-- Rodapé com paginação -->
                <Border Grid.Row="6"
                        Background="#DCE7F5"
                        Padding="10,8"
                        Margin="0,10,0,0">
                        <Grid>
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding TextoPaginacao}"
                                           Foreground="Black"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"/>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal">
                                        <Button Content="◀ Anterior"
                                                Command="{Binding PaginaAnteriorCommand}"
                                                Width="100"
                                                Height="24"
                                                Margin="0,0,5,0"/>
                                        <Button Content="Próxima ▶"
                                                Command="{Binding ProximaPaginaCommand}"
                                                Width="100"
                                                Height="24"/>
                                </StackPanel>
                        </Grid>
                </Border>
        </Grid>
</UserControl>