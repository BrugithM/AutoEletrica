<UserControl x:Class="SgaAutoEletrica.UI.Views.Clientes.ListaClientesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barra de Ferramentas -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="➕ Novo" Command="{Binding NovoClienteCommand}"
                    Width="90" Height="32" Margin="0,0,5,0" Background="#27AE60" Foreground="White"/>
            <Button Content="✏️ Editar" Command="{Binding EditarClienteCommand}"
                    Width="90" Height="32" Margin="0,0,5,0" Background="#3498DB" Foreground="White"/>
            <Button Content="🗑️ Excluir" Command="{Binding ExcluirClienteCommand}"
                    Width="90" Height="32" Margin="0,0,5,0" Background="#E74C3C" Foreground="White"/>
            <Button Content="🔄 Atualizar" Command="{Binding AtualizarCommand}"
                    Width="100" Height="32" Margin="0,0,20,0"/>
            
            <TextBlock Text="Pesquisar:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
            <TextBox Text="{Binding TermoBusca, UpdateSourceTrigger=PropertyChanged}"
                     Width="250" Height="32" VerticalContentAlignment="Center" Padding="5"
                     Margin="0,0,5,0"/>
            <Button Content="🔍" Command="{Binding BuscarCommand}"
                    Width="40" Height="32"/>
        </StackPanel>

        <!-- Título Clientes -->
        <TextBlock Grid.Row="1" Text="Clientes Cadastrados:" FontWeight="Bold" FontSize="14" Margin="0,5,0,5"/>

        <!-- Grid de Clientes -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Clientes}"
                  SelectedItem="{Binding ClienteSelecionado}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nome" Binding="{Binding NomeCompleto}" Width="300"/>
                <DataGridTextColumn Header="CPF" Binding="{Binding Cpf}" Width="150"/>
                <DataGridTextColumn Header="Telefone" Binding="{Binding Telefone}" Width="150"/>
                <DataGridTextColumn Header="Endereço" Binding="{Binding EnderecoCompleto}" Width="*"/>
                <DataGridTextColumn Header="Veículos" Binding="{Binding QuantidadeVeiculos}" Width="80"/>
                <DataGridTextColumn Header="Cadastro" Binding="{Binding DataCadastro, StringFormat=dd/MM/yyyy}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Espaçador -->
        <TextBlock Grid.Row="3" Text="" Height="10"/>

        <!-- Título Veículos -->
        <TextBlock Grid.Row="4" Text="Veículos Vinculados:" FontWeight="Bold" FontSize="14" Margin="0,5,0,5"/>

        <!-- Grid de Veículos -->
        <DataGrid Grid.Row="5"
                  ItemsSource="{Binding VeiculosDoCliente}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Placa" Binding="{Binding Placa}" Width="100"/>
                <DataGridTextColumn Header="Marca" Binding="{Binding Marca}" Width="120"/>
                <DataGridTextColumn Header="Modelo" Binding="{Binding Modelo}" Width="150"/>
                <DataGridTextColumn Header="Ano" Binding="{Binding Ano}" Width="70"/>
                <DataGridTextColumn Header="Versão" Binding="{Binding Versao}" Width="120"/>
                <DataGridTextColumn Header="Motor" Binding="{Binding Motor}" Width="100"/>
                <DataGridTextColumn Header="Tipo Motor" Binding="{Binding TipoMotor}" Width="100"/>
                <DataGridTextColumn Header="Cor" Binding="{Binding Cor}" Width="100"/>
                <DataGridTextColumn Header="Observação" Binding="{Binding Observacao}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Botão Vincular -->
        <Button Grid.Row="6" Content="🔗 Vincular Novo Veículo" 
                Command="{Binding VincularVeiculoCommand}"
                HorizontalAlignment="Right" Width="200" Height="35"
                Margin="0,10,0,0" Background="#3498DB" Foreground="White" FontWeight="SemiBold"/>
    </Grid>
</UserControl>