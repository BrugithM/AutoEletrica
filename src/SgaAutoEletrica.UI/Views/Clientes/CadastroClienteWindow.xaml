<Window x:Class="SgaAutoEletrica.UI.Views.Clientes.CadastroClienteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Titulo}" Height="500" Width="500"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Dados do Cliente" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

        <TextBlock Grid.Row="1" Text="Nome Completo:"/>
        <TextBox Grid.Row="2" Text="{Binding NomeCompleto, UpdateSourceTrigger=PropertyChanged}" 
                 Height="28" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="3" Text="CPF:"/>
        <TextBox Grid.Row="4" Text="{Binding Cpf, UpdateSourceTrigger=PropertyChanged}" 
                 Height="28" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="5" Text="Telefone:"/>
        <TextBox Grid.Row="6" Text="{Binding Telefone, UpdateSourceTrigger=PropertyChanged}" 
                 Height="28" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="7" Text="Endereço (opcional):" FontWeight="Bold" Margin="0,10,0,5"/>

        <ScrollViewer Grid.Row="8" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Logradouro:"/>
                <TextBox Text="{Binding Logradouro, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,0,0,5"/>

                <TextBlock Text="Número:"/>
                <TextBox Text="{Binding Numero, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,0,0,5"/>

                <TextBlock Text="Complemento:"/>
                <TextBox Text="{Binding Complemento, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,0,0,5"/>

                <TextBlock Text="Bairro:"/>
                <TextBox Text="{Binding Bairro, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,0,0,5"/>

                <TextBlock Text="Cidade:"/>
                <TextBox Text="{Binding Cidade, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,0,0,5"/>

                <TextBlock Text="Estado:"/>
                <TextBox Text="{Binding Estado, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,0,0,5"/>

                <TextBlock Text="CEP:"/>
                <TextBox Text="{Binding Cep, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,0,0,5"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Salvar" Width="100" Height="30" Margin="0,0,10,0" Click="BtnSalvar_Click"/>
            <Button Content="Cancelar" Width="100" Height="30" Click="BtnCancelar_Click"/>
        </StackPanel>
    </Grid>
</Window>