<Window x:Class="SgaAutoEletrica.UI.Views.Clientes.CadastroClienteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Titulo}"
        Height="540"
        Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Ficha Cadastral:"
                   FontWeight="Bold"
                   FontSize="13"
                   Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1">
            <!-- Dados Pessoais -->
            <GroupBox Header="Dados Pessoais"
                      Padding="10"
                      Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Nome Completo"/>
                    <TextBox Text="{Binding NomeCompleto, UpdateSourceTrigger=PropertyChanged}"
                             Height="26"
                             Margin="0,2,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="CPF"/>
                            <TextBox x:Name="TxtCpf"
                                     Text="{Binding Cpf, UpdateSourceTrigger=PropertyChanged}"
                                     Height="26"
                                    Margin="0,2,0,0"
                                     LostFocus="TxtCpf_LostFocus"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Telefone"/>
                            <TextBox x:Name="TxtTelefone"
                                     Text="{Binding Telefone, UpdateSourceTrigger=PropertyChanged}"
                                     Height="26"
                                    Margin="0,2,0,0"
                                     LostFocus="TxtTelefone_LostFocus"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!-- Endereço Residencial -->
            <GroupBox Header="Endereço Residencial"
                      Padding="10">
                <StackPanel>
                    <TextBlock Text="CEP"/>
                    <TextBox Text="{Binding Cep, UpdateSourceTrigger=PropertyChanged}"
                             Width="150"
                             Height="26"
                             HorizontalAlignment="Left"
                             Margin="0,2,0,10"/>

                    <TextBlock Text="Logradouro"/>
                    <TextBox Text="{Binding Logradouro, UpdateSourceTrigger=PropertyChanged}"
                             Height="26"
                             Margin="0,2,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Número"/>
                            <TextBox Text="{Binding Numero, UpdateSourceTrigger=PropertyChanged}"
                                     Height="26"
                                     Margin="0,2,0,10"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Complemento"/>
                            <TextBox Text="{Binding Complemento, UpdateSourceTrigger=PropertyChanged}"
                                     Height="26"
                                     Margin="0,2,0,10"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Bairro"/>
                            <TextBox Text="{Binding Bairro, UpdateSourceTrigger=PropertyChanged}"
                                     Height="26"
                                     Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Cidade"/>
                            <TextBox Text="{Binding Cidade, UpdateSourceTrigger=PropertyChanged}"
                                     Height="26"
                                     Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="UF"/>
                            <TextBox Text="{Binding Estado, UpdateSourceTrigger=PropertyChanged}"
                                     Height="26"
                                     Margin="0,2,0,0"
                                     MaxLength="2"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button Content="Salvar"
                    Width="90"
                    Height="30"
                    Margin="0,0,10,0"
                    Click="BtnSalvar_Click"/>
            <Button Content="Limpar"
                    Width="90"
                    Height="30"
                    Click="BtnLimpar_Click"/>
        </StackPanel>
    </Grid>
</Window>