<Window x:Class="SgaAutoEletrica.UI.Views.OrdensServico.CancelarOSWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cancelar OS"
        Height="250"
        Width="400"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Motivo do cancelamento:"
                    FontWeight="Bold"
                    Margin="0,0,0,10"/>
            <TextBox x:Name="TxtMotivo"
                    Height="80"
                    TextWrapping="Wrap"
                    AcceptsReturn="True"
                    Margin="0,0,0,15"/>

            <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right">
                <Button Content="Confirmar Cancelamento"
                        Width="160"
                        Style="{StaticResource BotaoPadraoStyle}"
                        Margin="0,0,10,0"
                        Click="BtnConfirmar_Click"/>
                <Button Content="Voltar"
                        Width="100"
                        Click="BtnVoltar_Click"
                        Style="{StaticResource BotaoPadraoStyle}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>