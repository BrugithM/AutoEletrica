<Window x:Class="SgaAutoEletrica.UI.Views.OrdensServico.CancelarOSWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cancelar OS" Height="250" Width="400"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Motivo do cancelamento:" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBox x:Name="TxtMotivo" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,15"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Confirmar Cancelamento" Width="160" Height="30" 
                        Background="#C0392B" Foreground="White" Margin="0,0,10,0" Click="BtnConfirmar_Click"/>
                <Button Content="Voltar" Width="100" Height="30" Click="BtnVoltar_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>