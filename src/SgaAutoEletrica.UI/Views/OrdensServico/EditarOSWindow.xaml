<Window x:Class="SgaAutoEletrica.UI.Views.OrdensServico.EditarOSWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Titulo}"
                Height="750"
                Width="1000"
        WindowStartupLocation="CenterScreen">

        <Grid Margin="15">
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cabeçalho -->
                <GroupBox Grid.Row="0"
                                Header="Cabeçalho da Ordem de Serviço"
                                Padding="10"
                                Margin="0,0,0,10">
                        <StackPanel>
                                <Grid>
                                        <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="15"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="15"/>
                                                <ColumnDefinition Width="150"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                                <TextBlock Text="O.S. Número:"
                                                                FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding NumeroOS}"
                                                                FontSize="14"
                                                                Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                                <TextBlock Text="Data de Abertura:"
                                                                FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding DataAbertura}"
                                                                FontSize="14"
                                                                Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="4">
                                                <TextBlock Text="Status Atual:"
                                                                FontWeight="SemiBold"/>
                                                <Border Background="#0A246A"
                                                                Padding="8,4"
                                                                CornerRadius="3"
                                                                Margin="0,2,0,0">
                                                        <TextBlock Text="{Binding StatusAtual}"
                                                                        Foreground="White"
                                                                        FontWeight="SemiBold"/>
                                                </Border>
                                        </StackPanel>
                                </Grid>

                                <Border Background="#F5F5F5"
                                                Padding="8"
                                                Margin="0,10,0,0"
                                                CornerRadius="3">
                                        <StackPanel>
                                                <TextBlock Text="{Binding InfoCliente}"
                                                                FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding InfoVeiculo}"
                                                                FontWeight="SemiBold"
                                                                Margin="0,3,0,0"/>
                                        </StackPanel>
                                </Border>
                        </StackPanel>
                </GroupBox>

                <!-- Abas -->
                <TabControl Grid.Row="1"
                                Margin="0,0,0,10"
                                MaxHeight="320">
                        <!-- Aba de Serviços -->
                        <TabItem Header="Serviços Aplicados">
                                <Grid Margin="10">
                                        <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0"
                                                        Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0"
                                                                Orientation="Horizontal">
                                                        <TextBlock Text="Serviço:"
                                                                        VerticalAlignment="Center"
                                                                        Margin="0,0,5,0"/>
                                                        <ComboBox ItemsSource="{Binding ServicosDisponiveis}"
                                                                  SelectedItem="{Binding ServicoSelecionado}"
                                                                  DisplayMemberPath="Nome"
                                                                  Width="400"
                                                                        Height="28"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1"
                                                                Orientation="Horizontal">
                                                        <Button Content="➕ Adicionar Serviço"
                                                                        Click="BtnAdicionarServico_Click"
                                                                Width="150"
                                                                        Style="{StaticResource BotaoPadraoStyle}"/>
                                                        <Button Content="➖ Remover Selecionado"
                                                                        Command="{Binding RemoverServicoCommand}"
                                                                Width="170"
                                                                        Style="{StaticResource BotaoPadraoStyle}"/>
                                                </StackPanel>
                                        </Grid>

                                        <DataGrid Grid.Row="1"
                                                  ItemsSource="{Binding ServicosNaOS}"
                                                  SelectedItem="{Binding ServicoSelecionadoParaRemover}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  CanUserAddRows="False">
                                                <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Serviço"
                                                                        Binding="{Binding NomeServico}"
                                                                        Width="*"/>
                                                        <DataGridTextColumn Header="Valor Unit. (R$)"
                                                                        Binding="{Binding PrecoUnitario, StringFormat=C2}"
                                                                        Width="150"/>
                                                </DataGrid.Columns>
                                        </DataGrid>
                                </Grid>
                        </TabItem>

                        <!-- Aba de Peças -->
                        <TabItem Header="Peças Utilizadas">
                                <Grid Margin="10">
                                        <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0"
                                                        Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0"
                                                                Orientation="Horizontal">
                                                        <TextBlock Text="Peça:"
                                                                        VerticalAlignment="Center"
                                                                        Margin="0,0,5,0"/>
                                                        <ComboBox ItemsSource="{Binding PecasDisponiveis}"
                                                                  SelectedItem="{Binding PecaSelecionada}"
                                                                  DisplayMemberPath="Nome"
                                                                  Width="300"
                                                                        Height="24"
                                                                        Margin="0,0,10,0"/>
                                                        <TextBlock Text="Qtd:"
                                                                        VerticalAlignment="Center"
                                                                        Margin="0,0,5,0"/>
                                                        <TextBox Text="{Binding QuantidadePeca, UpdateSourceTrigger=PropertyChanged}"
                                                                 Width="60"
                                                                        Height="24"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1"
                                                                Orientation="Horizontal">
                                                        <Button Content="➕ Adicionar Peça"
                                                                        Click="BtnAdicionarPeca_Click"
                                                                Width="140"
                                                                        Margin="0,0,5,0"
                                                                Style="{StaticResource BotaoPadraoStyle}"/>
                                                        <Button Content="➖ Remover Selecionado"
                                                                        Command="{Binding RemoverPecaCommand}"
                                                                Width="170"
                                                                        Style="{StaticResource BotaoPadraoStyle}"/>
                                                </StackPanel>
                                        </Grid>

                                        <DataGrid Grid.Row="1"
                                                  ItemsSource="{Binding PecasNaOS}"
                                                  SelectedItem="{Binding PecaSelecionadaParaRemover}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  CanUserAddRows="False">
                                                <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Peça"
                                                                        Binding="{Binding NomePeca}"
                                                                        Width="*"/>
                                                        <DataGridTextColumn Header="Qtd"
                                                                        Binding="{Binding Quantidade}"
                                                                        Width="80"/>
                                                        <DataGridTextColumn Header="Valor Unit. (R$)"
                                                                        Binding="{Binding PrecoUnitario, StringFormat=C2}"
                                                                        Width="150"/>
                                                        <DataGridTextColumn Header="Subtotal (R$)"
                                                                        Binding="{Binding ValorTotal, StringFormat=C2}"
                                                                        Width="150"/>
                                                </DataGrid.Columns>
                                        </DataGrid>
                                </Grid>
                        </TabItem>

                        <!-- Aba de Observações -->
                        <TabItem Header="Observações Finais">
                                <TextBox Text="{Binding Observacao, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="10"
                                                TextWrapping="Wrap"
                                                AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"/>
                        </TabItem>
                </TabControl>

                <!-- Resumo e Botões -->
                <Grid Grid.Row="2"
                                Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="380"/>
                                <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Bottom">
                                <Button Content="Salvar"
                                                Click="BtnSalvar_Click"
                                        Width="160"
                                        Style="{StaticResource BotaoPadraoStyle}"/>
                        </StackPanel>

                        <GroupBox Grid.Column="0"
                                        Header="Resumo de Valores"
                                        Padding="10">
                                <Grid>
                                        <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0"
                                                        Grid.Column="0"
                                                        Text="Subtotal Serviços:"
                                                        FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="0"
                                                        Grid.Column="1"
                                                        Text="{Binding ValorTotalServicos, StringFormat=C2}"
                                                        HorizontalAlignment="Right"/>

                                        <TextBlock Grid.Row="1"
                                                        Grid.Column="0"
                                                        Text="Subtotal Peças:"
                                                        FontWeight="SemiBold"
                                                        Margin="0,5,0,0"/>
                                        <TextBlock Grid.Row="1"
                                                        Grid.Column="1"
                                                        Text="{Binding ValorTotalPecas, StringFormat=C2}"
                                                   HorizontalAlignment="Right"
                                                        Margin="0,5,0,0"/>

                                        <TextBlock Grid.Row="2"
                                                        Grid.Column="0"
                                                        Text="Desconto Aplicado:"
                                                        FontWeight="SemiBold"
                                                        Margin="0,8,0,0"
                                                        VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="2"
                                                        Grid.Column="1"
                                                 Text="{Binding Desconto, UpdateSourceTrigger=LostFocus, Converter={StaticResource DecimalConverter}}"
                                                 Width="120"
                                                        Height="24"
                                                        Margin="0,8,0,0"
                                                        HorizontalAlignment="Right"/>

                                        <Separator Grid.Row="3"
                                                        Grid.ColumnSpan="2"
                                                        Margin="0,8,0,8"/>

                                        <TextBlock Grid.Row="4"
                                                        Grid.Column="0"
                                                        Text="TOTAL DA O.S.:"
                                                        FontSize="16"
                                                        FontWeight="Bold"/>
                                        <TextBlock Grid.Row="4"
                                                        Grid.Column="1"
                                                        Text="{Binding ValorTotalGeral, StringFormat=C2}"
                                                   FontSize="18"
                                                        FontWeight="Bold"
                                                        Foreground="#0A246A"
                                                        HorizontalAlignment="Right"/>
                                </Grid>
                        </GroupBox>
                </Grid>
        </Grid>
</Window>