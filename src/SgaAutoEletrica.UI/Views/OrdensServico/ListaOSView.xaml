<UserControl x:Class="SgaAutoEletrica.UI.Views.OrdensServico.ListaOSView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barra de Ferramentas -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="➕ Nova OS" Command="{Binding NovaOSCommand}"
                    Width="120" Height="32" Margin="0,0,5,0" Background="#27AE60" Foreground="White"/>
            <Button Content="🔄 Atualizar" Command="{Binding AtualizarCommand}"
                    Width="100" Height="32" Margin="0,0,20,0"/>

            <TextBlock Text="Pesquisar:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
            <TextBox Text="{Binding TermoBusca, UpdateSourceTrigger=PropertyChanged}"
                     Width="250" Height="32" VerticalContentAlignment="Center" Padding="5"
                     Margin="0,0,5,0"
                     ToolTip="Número da OS, Nome do Cliente ou Placa"/>
            <Button Content="🔍" Command="{Binding BuscarCommand}" Width="40" Height="32" Margin="0,0,15,0"/>

            <TextBlock Text="Status:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
            <ComboBox ItemsSource="{Binding StatusOpcoes}"
                      SelectedItem="{Binding StatusFiltro}"
                      Width="160" Height="32"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="Ordens de Serviço:" FontWeight="Bold" FontSize="14" 
                   Margin="0,0,0,5"/>

        <!-- Grid de OS -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Ordens}"
                  SelectedItem="{Binding OsSelecionada}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  MouseDoubleClick="DataGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nº" Binding="{Binding Numero}" Width="70"/>
                <DataGridTextColumn Header="Cliente" Binding="{Binding NomeCliente}" Width="250"/>
                <DataGridTextColumn Header="Veículo" Binding="{Binding ModeloVeiculo}" Width="150"/>
                <DataGridTextColumn Header="Placa" Binding="{Binding PlacaVeiculo}" Width="100"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130"/>
                <DataGridTextColumn Header="Valor" Binding="{Binding ValorTotal, StringFormat=C2}" Width="120"/>
                <DataGridTextColumn Header="Abertura" Binding="{Binding DataAbertura, StringFormat=dd/MM/yyyy HH:mm}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Rodapé com paginação -->
        <Border Grid.Row="3" Background="#2C3E50" Padding="10,8" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding TextoPaginacao}" 
                           Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="◀ Anterior" Command="{Binding PaginaAnteriorCommand}"
                            Width="100" Height="28" Margin="0,0,5,0"/>
                    <Button Content="Próxima ▶" Command="{Binding ProximaPaginaCommand}"
                            Width="100" Height="28"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>