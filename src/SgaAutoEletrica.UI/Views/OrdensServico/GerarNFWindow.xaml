<Window x:Class="SgaAutoEletrica.UI.Views.OrdensServico.GerarNFWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gerar Nota Fiscal" Height="200" Width="350"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Número da Nota Fiscal:" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBox x:Name="TxtNumeroNF" Height="28" Margin="0,0,0,15"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Gerar NF" Width="100" Height="30" 
                        Background="#3498DB" Foreground="White" Margin="0,0,10,0" Click="BtnGerar_Click"/>
                <Button Content="Cancelar" Width="100" Height="30" Click="BtnCancelar_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>