<Window x:Class="SgaAutoEletrica.UI.Views.OrdensServico.CriacaoOSWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nova Ordem de Serviço" Height="750" Width="800"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Nova Ordem de Serviço" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Cliente:"/>
                <ComboBox ItemsSource="{Binding Clientes}"
                          SelectedItem="{Binding ClienteSelecionado}"
                          DisplayMemberPath="NomeCompleto"
                          Height="28"/>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Text="Veículo:"/>
                <ComboBox ItemsSource="{Binding Veiculos}"
                          SelectedItem="{Binding VeiculoSelecionado}"
                          DisplayMemberPath="Modelo"
                          Height="28"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="2" Text="Observação:"/>
        <TextBox Grid.Row="3" Text="{Binding Observacao, UpdateSourceTrigger=PropertyChanged}" 
                 Height="50" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="4" Text="Adicionar itens:" FontWeight="Bold" Margin="0,5,0,5"/>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Coluna de Peças -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Peças:"/>
                <ComboBox Grid.Row="1" ItemsSource="{Binding PecasDisponiveis}"
                          SelectedItem="{Binding PecaSelecionada}"
                          DisplayMemberPath="Nome"
                          Height="28" Margin="0,0,0,5"/>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Qtd:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Text="{Binding QuantidadePeca, UpdateSourceTrigger=PropertyChanged}" 
                             Width="50" Height="25" Margin="0,0,5,0"/>
                    <Button Content="Adicionar" Click="BtnAdicionarPeca_Click" Width="80" Height="25"/>
                </StackPanel>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <DataGrid ItemsSource="{Binding PecasNaOS}" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectedItem="{Binding PecaSelecionadaParaRemover}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Peça" Binding="{Binding Nome}" Width="150"/>
                            <DataGridTextColumn Header="Qtd" Binding="{Binding Quantidade}" Width="50"/>
                            <DataGridTextColumn Header="Preço" Binding="{Binding PrecoUnitario, StringFormat=C2}" Width="80"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding ValorTotal, StringFormat=C2}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Column="1" Content="Remover" 
                            Command="{Binding RemoverPecaCommand}" 
                            CommandParameter="{Binding PecaSelecionadaParaRemover}"
                            Width="80" Height="25" Margin="5,0,0,0" VerticalAlignment="Top"
                            Background="#E74C3C" Foreground="White"/>
                </Grid>

                <TextBlock Grid.Row="4" Text="Total Peças:" FontWeight="Bold"/>
                <TextBlock Grid.Row="4" Text="{Binding ValorTotalPecas, StringFormat=C2}" 
                           HorizontalAlignment="Right" FontWeight="Bold"/>
            </Grid>

            <!-- Coluna de Serviços -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Serviços:"/>
                <ComboBox Grid.Row="1" ItemsSource="{Binding ServicosDisponiveis}"
                          SelectedItem="{Binding ServicoSelecionado}"
                          DisplayMemberPath="Nome"
                          Height="28" Margin="0,0,0,5"/>

                <Button Grid.Row="2" Content="Adicionar Serviço" Click="BtnAdicionarServico_Click" 
                        Width="120" Height="25" Margin="0,0,0,5"/>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <DataGrid ItemsSource="{Binding ServicosNaOS}" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectedItem="{Binding ServicoSelecionadoParaRemover}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Serviço" Binding="{Binding Nome}" Width="150"/>
                            <DataGridTextColumn Header="Preço" Binding="{Binding Preco, StringFormat=C2}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Column="1" Content="Remover" 
                            Command="{Binding RemoverServicoCommand}" 
                            CommandParameter="{Binding ServicoSelecionadoParaRemover}"
                            Width="80" Height="25" Margin="5,0,0,0" VerticalAlignment="Top"
                            Background="#E74C3C" Foreground="White"/>
                </Grid>

                <TextBlock Grid.Row="4" Text="Total Serviços:" FontWeight="Bold"/>
                <TextBlock Grid.Row="4" Text="{Binding ValorTotalServicos, StringFormat=C2}" 
                           HorizontalAlignment="Right" FontWeight="Bold"/>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock Text="TOTAL GERAL:" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="{Binding ValorTotalGeral, StringFormat=C2}" FontSize="18" FontWeight="Bold" 
                       VerticalAlignment="Center" Margin="0,0,15,0"/>
            <Button Content="Salvar OS" Width="110" Height="35" Click="BtnSalvar_Click"
                    Background="#27AE60" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>