<UserControl x:Class="SgaAutoEletrica.UI.Views.OrdensServico.ListaNotasFiscaisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Notas Fiscais Emitidas" FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>

        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding Notas}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Número" Binding="{Binding Numero}" Width="130"/>
                <DataGridTextColumn Header="Data Emissão" Binding="{Binding DataEmissao, StringFormat=dd/MM/yyyy HH:mm}" Width="150"/>
                <DataGridTextColumn Header="Cliente" Binding="{Binding NomeCliente}" Width="200"/>
                <DataGridTextColumn Header="Placa" Binding="{Binding PlacaVeiculo}" Width="100"/>
                <DataGridTextColumn Header="Valor Total" Binding="{Binding ValorTotal, StringFormat=C2}" Width="120"/>
                <DataGridTextColumn Header="Observação" Binding="{Binding Observacao}" Width="250"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>