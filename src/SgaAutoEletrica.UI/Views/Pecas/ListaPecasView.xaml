<UserControl x:Class="SgaAutoEletrica.UI.Views.Pecas.ListaPecasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding AtualizarCommand}"/>
    </UserControl.InputBindings>
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barra de Ferramentas -->
        <Border Grid.Row="0" Padding="5" Background="#DCE7F5">
            <StackPanel Orientation="Horizontal">
                <Button Content="➕ Novo" Command="{Binding NovaPecaCommand}"
                        Width="70" Style="{StaticResource BotaoToolbarStyle}"/>
                <Button Content="✏️ Editar" Command="{Binding EditarPecaCommand}"
                        Width="75" Style="{StaticResource BotaoToolbarStyle}"/>
                <Button Content="{Binding TextoBotaoDesativar}" Command="{Binding DesativarPecaCommand}"
                        Width="95" Style="{StaticResource BotaoToolbarStyle}"/>
                <Button Content="📦 Mov. Estoque" Command="{Binding MovimentarEstoqueCommand}"
                        Width="120" Style="{StaticResource BotaoToolbarStyle}"/>
                <Button Content="🏷️ Etiqueta" Click="BtnImprimirEtiqueta_Click"
                        Width="100" Style="{StaticResource BotaoToolbarStyle}"/>
                <Button Content="⟳ Atualizar" Command="{Binding AtualizarCommand}"
                        Width="85" Style="{StaticResource BotaoToolbarStyle}"/>
            </StackPanel>
        </Border>

        <!-- Alternador de modo -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10">
            <Button Content="⌕ Busca Avançada"
                    Command="{Binding AlternarModoBuscaCommand}"
                    Width="160" Height="30"
                    Style="{StaticResource BotaoPadraoStyle}"/>
        </StackPanel>

        <!-- Busca Rápida -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="10,0,10,10"
                    Visibility="{Binding ModoBuscaRapida, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="Pesquisar:"
                       VerticalAlignment="Center"
                       Margin="0,0,5,0"
                       FontSize="12"/>
            <TextBox Text="{Binding TermoBusca, UpdateSourceTrigger=PropertyChanged}"
                     Width="180"
                     Height="28"
                     VerticalContentAlignment="Center"
                     Padding="4"
                     Margin="0,0,2,0"
                     ToolTip="Nome, Código, Código de Barras ou Marca"/>
            <Button Content="⌕"
                    Command="{Binding BuscarCommand}"
                    Width="28"
                    Margin="0,0,10,0"
                    IsDefault="True"
                    Style="{StaticResource BotaoToolbarStyle}"
                    Background="Transparent"/>

            <CheckBox Content="Mostrar inativos"
                      IsChecked="{Binding MostrarInativos}"
                      VerticalAlignment="Center"
                      FontWeight="SemiBold"/>
        </StackPanel>

        <!-- Busca Avançada -->
        <Border Grid.Row="2"
                Background="#F5F5F5"
                Padding="10"
                Margin="10,0,10,10"
                CornerRadius="5"
                Visibility="{Binding ModoBuscaAvancada, Converter={StaticResource BoolParaVisibilidade}}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Nome:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding BuscaNome, UpdateSourceTrigger=PropertyChanged}"
                                 Height="28" Padding="5"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,5,0">
                        <TextBlock Text="Código da Peça:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding BuscaCodigoPeca, UpdateSourceTrigger=PropertyChanged}"
                                 Height="28" Padding="5"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Código de Barras:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding BuscaCodigoBarras, UpdateSourceTrigger=PropertyChanged}"
                                 Height="28" Padding="5"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Marca:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <ComboBox ItemsSource="{Binding Marcas}"
                                  SelectedItem="{Binding BuscaMarca}"
                                  DisplayMemberPath="Nome"
                                  Height="28"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,5,0">
                        <TextBlock Text="Categoria:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <ComboBox ItemsSource="{Binding Categorias}"
                                  SelectedItem="{Binding BuscaCategoria}"
                                  DisplayMemberPath="Nome"
                                  Height="28"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Fornecedor:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <ComboBox ItemsSource="{Binding Fornecedores}"
                                  SelectedItem="{Binding BuscaFornecedor}"
                                  DisplayMemberPath="NomeEmpresa"
                                  Height="28"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <CheckBox Content="Apenas estoque baixo"
                                  IsChecked="{Binding BuscaApenasEstoqueBaixo}"
                                  VerticalAlignment="Center"
                                  FontWeight="SemiBold"
                                  Margin="0,0,10,0"/>
                        <CheckBox Content="Mostrar inativos"
                                  IsChecked="{Binding MostrarInativos}"
                                  VerticalAlignment="Center"
                                  FontWeight="SemiBold"
                                  Margin="0,0,15,0"/>
                        <Button Content="Limpar"
                                Command="{Binding LimparCommand}"
                                Width="80" Margin="0,0,10,0"
                                Style="{StaticResource BotaoPadraoStyle}"/>
                        <Button Content="⌕ Buscar"
                                Command="{Binding BuscarCommand}"
                                Width="90"
                                IsDefault="True"
                                Style="{StaticResource BotaoPadraoStyle}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Grid de Peças -->
        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding Pecas}"
                  SelectedItem="{Binding PecaSelecionada}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  Margin="10"
                  RowStyle="{StaticResource PecaRowStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                <DataGridTextColumn Header="Código" Binding="{Binding CodigoPeca}" Width="80"/>
                <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="200"/>
                <DataGridTextColumn Header="Marca" Binding="{Binding MarcaNome}" Width="100"/>
                <DataGridTextColumn Header="Categoria" Binding="{Binding CategoriaNome}" Width="100"/>
                <DataGridTextColumn Header="Cód. Barras" Binding="{Binding CodigoBarras}" Width="120"/>
                <DataGridTextColumn Header="Est." Binding="{Binding Estoque}" Width="50"/>
                <DataGridTextColumn Header="Mín." Binding="{Binding EstoqueMinimo}" Width="50"/>
                <DataGridTextColumn Header="Custo" Binding="{Binding ValorCusto, StringFormat=C2}" Width="80"/>
                <DataGridTextColumn Header="Venda" Binding="{Binding ValorVenda, StringFormat=C2}" Width="80"/>
                <DataGridTextColumn Header="Lucro" Binding="{Binding MargemLucro, StringFormat={}{0:F1}%}" Width="70"/>
                <DataGridTextColumn Header="Markup" Binding="{Binding MarkupPercentual, StringFormat={}{0:F1}%}" Width="70"/>
                <DataGridTextColumn Header="Fornecedor" Binding="{Binding FornecedorNome}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Painel do Fornecedor -->
        <Border Grid.Row="4"
                Background="#F5F5F5"
                Padding="10"
                Margin="0,10,0,0"
                Visibility="{Binding TemPecaSelecionada, Converter={StaticResource BoolParaVisibilidade}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Fornecedor da Peça:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock>
                        <Run Text="Nome: " FontWeight="SemiBold"/>
                        <Run Text="{Binding FornecedorNomeExibir, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock>
                        <Run Text="CNPJ: " FontWeight="SemiBold"/>
                        <Run Text="{Binding FornecedorCnpjExibir, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock>
                        <Run Text="Telefone: " FontWeight="SemiBold"/>
                        <Run Text="{Binding FornecedorTelefoneExibir, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock>
                        <Run Text="Contato: " FontWeight="SemiBold"/>
                        <Run Text="{Binding FornecedorContatoExibir, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Rodapé com paginação -->
        <Border Grid.Row="6"
                Background="#DCE7F5"
                Padding="10,8"
                Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding TextoPaginacao}"
                           Foreground="Black"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="◀ Anterior"
                            Command="{Binding PaginaAnteriorCommand}"
                            Width="100" Height="28" Margin="0,0,5,0"/>
                    <Button Content="Próxima ▶"
                            Command="{Binding ProximaPaginaCommand}"
                            Width="100" Height="28"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>