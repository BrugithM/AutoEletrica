<UserControl x:Class="SgaAutoEletrica.UI.Views.Pecas.ListaPecasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Peças" FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" 
                     Text="{Binding TermoBusca, UpdateSourceTrigger=PropertyChanged}"
                     Height="30" FontSize="14" Padding="5" Margin="0,0,10,0"
                     ToolTip="Busca por nome, ID da peça ou código"/>

            <Button Grid.Column="1" Content="Buscar" Command="{Binding BuscarCommand}"
                    Width="80" Height="30" Margin="0,0,10,0"/>

            <Button Grid.Column="2" Content="Limpar" Command="{Binding LimparCommand}"
                    Width="80" Height="30" Margin="0,0,10,0"/>

            <Button Grid.Column="3" Content="+ Nova Peça" Command="{Binding NovaPecaCommand}"
                    Width="120" Height="30" Background="#27AE60" Foreground="White"/>
        </Grid>

        <DataGrid Grid.Row="2" 
                  ItemsSource="{Binding Pecas}"
                  SelectedItem="{Binding PecaSelecionada}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID Peça" Binding="{Binding IdPeca}" Width="90"/>
                <DataGridTextColumn Header="Código" Binding="{Binding CodigoPeca}" Width="80"/>
                <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="200"/>
                <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="250"/>
                <DataGridTextColumn Header="Marca" Binding="{Binding Marca}" Width="100"/>
                <DataGridTextColumn Header="Categoria" Binding="{Binding CategoriaNome}" Width="100"/>
                <DataGridTextColumn Header="Fornecedor" Binding="{Binding FornecedorNome}" Width="150"/>
                <DataGridTextColumn Header="Custo" Binding="{Binding ValorCusto, StringFormat=C2}" Width="80"/>
                <DataGridTextColumn Header="Venda" Binding="{Binding ValorVenda, StringFormat=C2}" Width="80"/>
                <DataGridTextColumn Header="Imposto %" Binding="{Binding Imposto, StringFormat=F1}" Width="80"/>
                <DataGridTextColumn Header="Estoque" Binding="{Binding Estoque}" Width="70"/>
                <DataGridTextColumn Header="Mín." Binding="{Binding EstoqueMinimo}" Width="50"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Editar" Command="{Binding EditarPecaCommand}" 
                    Width="80" Height="30" Margin="0,0,10,0"/>
            <Button Content="Mov. Estoque" Command="{Binding MovimentarEstoqueCommand}" 
                    Width="100" Height="30" Margin="0,0,10,0"/>
            <Button Content="Excluir" Command="{Binding ExcluirPecaCommand}" 
                    Width="80" Height="30" Background="#C0392B" Foreground="White"/>
        </StackPanel>
    </Grid>
</UserControl>