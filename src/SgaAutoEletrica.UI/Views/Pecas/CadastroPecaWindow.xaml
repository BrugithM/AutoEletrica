<Window x:Class="SgaAutoEletrica.UI.Views.Pecas.CadastroPecaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Titulo}"
        Height="560"
        Width="540"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Ficha Cadastral:"
                   FontWeight="Bold"
                   FontSize="13"
                   Margin="0,0,0,10"/>

        <GroupBox Grid.Row="1"
                  Header="Dados da Peça"
                  Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- ID / Código / Código de Barras -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ID"/>
                            <TextBox Text="{Binding IdPeca, UpdateSourceTrigger=PropertyChanged}"
                                     Height="26"
                                     Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Código"/>
                            <TextBox Text="{Binding CodigoPeca, UpdateSourceTrigger=PropertyChanged}"
                                     Height="26"
                                     Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Código de Barras"/>
                            <TextBox Text="{Binding CodigoBarras, UpdateSourceTrigger=PropertyChanged}"
                                     Height="26"
                                     Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Nome -->
                    <TextBlock Text="Nome"/>
                    <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}"
                             Height="26"
                             Margin="0,2,0,10"/>

                    <!-- Descrição -->
                    <TextBlock Text="Descrição"/>
                    <TextBox Text="{Binding Descricao, UpdateSourceTrigger=PropertyChanged}"
                             Height="26"
                             Margin="0,2,0,10"/>

                    <!-- Marca -->
                    <TextBlock Text="Marca"/>
                    <TextBox Text="{Binding Marca, UpdateSourceTrigger=PropertyChanged}"
                             Height="26"
                             Margin="0,2,0,10"/>

                    <!-- Categoria + Fornecedor -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Categoria"/>
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding Categorias}"
                                          SelectedItem="{Binding CategoriaSelecionada}"
                                          DisplayMemberPath="Nome"
                                          Height="26"/>

                                <Button Grid.Column="1"
                                        Content="➕"
                                        Command="{Binding NovaCategoriaCommand}"
                                        Width="30"
                                        Style="{StaticResource BotaoPadraoStyle}"
                                        Margin="5,0,0,0"
                                        ToolTip="Nova Categoria"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Fornecedor"/>
                            <ComboBox ItemsSource="{Binding Fornecedores}"
                                      SelectedItem="{Binding FornecedorSelecionado}"
                                      DisplayMemberPath="NomeEmpresa"
                                      Height="26"
                                      Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Valores -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Valor de Custo"/>
                            <TextBox Text="{Binding ValorCusto, UpdateSourceTrigger=LostFocus, Converter={StaticResource DecimalConverter}}"
                                     Height="26"
                                    Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Imposto (%)"/>
                            <TextBox Text="{Binding Imposto, UpdateSourceTrigger=LostFocus, Converter={StaticResource DecimalConverter}}"
                                     Height="26"
                                    Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Valor de Venda"/>
                            <TextBox Text="{Binding ValorVenda, UpdateSourceTrigger=LostFocus, Converter={StaticResource DecimalConverter}}"
                                     Height="26"
                                    Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Estoque -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Estoque Inicial"/>
                            <TextBox Text="{Binding EstoqueInicial, UpdateSourceTrigger=PropertyChanged}"
                                     Height="26"
                                     Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Estoque Mínimo"/>
                            <TextBox Text="{Binding EstoqueMinimo, UpdateSourceTrigger=PropertyChanged}"
                                     Height="26"
                                     Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </GroupBox>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button Content="Salvar"
                    Width="90"
                    Style="{StaticResource BotaoPadraoStyle}"
                    Margin="0,0,10,0"
                    Click="BtnSalvar_Click"/>
            <Button Content="Limpar"
                    Width="90"
                    Style="{StaticResource BotaoPadraoStyle}"
                    Click="BtnLimpar_Click"/>
        </StackPanel>
    </Grid>
</Window>