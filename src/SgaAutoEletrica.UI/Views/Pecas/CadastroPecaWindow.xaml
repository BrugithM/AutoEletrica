<Window x:Class="SgaAutoEletrica.UI.Views.Pecas.CadastroPecaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Titulo}"
        Height="650"
        Width="550"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Dados da Peça"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="ID da Peça (fabricante):"/>
                <TextBox Text="{Binding IdPeca, UpdateSourceTrigger=PropertyChanged}"
                         Height="28"
                         Margin="0,0,0,8"/>

                <TextBlock Text="Código da Peça (interno):"/>
                <TextBox Text="{Binding CodigoPeca, UpdateSourceTrigger=PropertyChanged}"
                         Height="28"
                         Margin="0,0,0,8"/>

                <TextBlock Text="Código de Barras:"/>
                <TextBox Text="{Binding CodigoBarras, UpdateSourceTrigger=PropertyChanged}"
                         Height="28"
                         Margin="0,0,0,8"/>

                <TextBlock Text="Nome:"/>
                <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}"
                         Height="28"
                         Margin="0,0,0,8"/>

                <TextBlock Text="Descrição:"/>
                <TextBox Text="{Binding Descricao, UpdateSourceTrigger=PropertyChanged}"
                         Height="28"
                         Margin="0,0,0,8"/>

                <TextBlock Text="Marca:"/>
                <TextBox Text="{Binding Marca, UpdateSourceTrigger=PropertyChanged}"
                         Height="28"
                         Margin="0,0,0,8"/>

                <ComboBox ItemsSource="{Binding Categorias}"
                          SelectedItem="{Binding CategoriaSelecionada}"
                          DisplayMemberPath="Nome"
                          Height="28"
                        Margin="0,0,0,8"/>

                <ComboBox ItemsSource="{Binding Fornecedores}"
                          SelectedItem="{Binding FornecedorSelecionado}"
                          DisplayMemberPath="NomeEmpresa"
                          Height="28"
                        Margin="0,0,0,8"/>

                <TextBlock Text="Valor de Custo (R$):"/>
                <TextBox Text="{Binding ValorCusto, UpdateSourceTrigger=PropertyChanged}"
                         Height="28"
                         Margin="0,0,0,8"/>

                <TextBlock Text="Valor de Venda (R$):"/>
                <TextBox Text="{Binding ValorVenda, UpdateSourceTrigger=PropertyChanged}"
                         Height="28"
                         Margin="0,0,0,8"/>

                <TextBlock Text="Imposto (%):"/>
                <TextBox Text="{Binding Imposto, UpdateSourceTrigger=PropertyChanged}"
                         Height="28"
                         Margin="0,0,0,8"/>

                <TextBlock Text="Estoque Inicial:"/>
                <TextBox Text="{Binding EstoqueInicial, UpdateSourceTrigger=PropertyChanged}"
                         Height="28"
                         Margin="0,0,0,8"/>

                <TextBlock Text="Estoque Mínimo:"/>
                <TextBox Text="{Binding EstoqueMinimo, UpdateSourceTrigger=PropertyChanged}"
                         Height="28"
                         Margin="0,0,0,8"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button Content="Salvar"
                    Width="100"
                    Height="30"
                    Margin="0,0,10,0"
                    Click="BtnSalvar_Click"/>
            <Button Content="Cancelar"
                    Width="100"
                    Height="30"
                    Click="BtnCancelar_Click"/>
        </StackPanel>
    </Grid>
</Window>