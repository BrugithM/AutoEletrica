<Window x:Class="SgaAutoEletrica.UI.Views.Pecas.MovimentacaoEstoqueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Movimentação de Estoque" Height="300" Width="400"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Movimentar Estoque" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

            <TextBlock Text="Peça:" FontWeight="Bold"/>
            <TextBlock Text="{Binding NomePeca}" Margin="0,0,0,10"/>

            <TextBlock Text="Estoque Atual:"/>
            <TextBlock Text="{Binding EstoqueAtual}" FontWeight="Bold" Margin="0,0,0,15"/>

            <RadioButton Content="Entrada (adicionar)" IsChecked="{Binding EhEntrada}" 
                         GroupName="Tipo" Margin="0,0,0,5"/>
            <RadioButton Content="Saída (remover)" GroupName="Tipo" 
                         IsChecked="{Binding EhEntrada, Converter={StaticResource InverterBoolConverter}}" 
                         Margin="0,0,0,15"/>

            <TextBlock Text="Quantidade:"/>
            <TextBox Text="{Binding Quantidade, UpdateSourceTrigger=PropertyChanged}" 
                     Height="28" Margin="0,0,0,15"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Confirmar" Width="100" Height="30" Margin="0,0,10,0" Click="BtnSalvar_Click"/>
                <Button Content="Cancelar" Width="100" Height="30" Click="BtnCancelar_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>