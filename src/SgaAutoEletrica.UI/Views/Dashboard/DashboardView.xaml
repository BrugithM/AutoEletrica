<UserControl x:Class="SgaAutoEletrica.UI.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="15">
            <!-- Filtros -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <TextBlock Text="Mês:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,5,0"/>
                <ComboBox ItemsSource="{Binding Meses}"
                          SelectedItem="{Binding MesSelecionado}"
                          Width="60" Height="26" Margin="0,0,15,0"/>

                <TextBlock Text="Ano:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,5,0"/>
                <ComboBox ItemsSource="{Binding Anos}"
                          SelectedItem="{Binding AnoSelecionado}"
                          Width="60" Height="26"/>
            </StackPanel>

            <!-- Resumo do Mês -->
            <GroupBox Header="Resumo do Mês" Padding="10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Faturamento:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ResumoMensal.FaturamentoTotal, StringFormat=C2}" 
                               FontWeight="Bold" Foreground="#0A246A"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="OS Abertas:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ResumoMensal.OSAbertas}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="OS Finalizadas:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ResumoMensal.OSFinalizadas}"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Ticket Médio:" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ResumoMensal.TicketMedio, StringFormat=C2}"/>
                </Grid>
            </GroupBox>

            <!-- Resumo do Ano -->
            <GroupBox Header="Resumo do Ano" Padding="10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Faturamento:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ResumoAnual.FaturamentoTotal, StringFormat=C2}" 
                               FontWeight="Bold" Foreground="#0A246A"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="OS Finalizadas:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ResumoAnual.OSFinalizadas}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Ticket Médio:" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ResumoAnual.TicketMedio, StringFormat=C2}"/>
                </Grid>
            </GroupBox>

            <!-- Alertas -->
            <GroupBox Header="Alertas" Padding="10">
                <StackPanel>
                    <TextBlock Margin="0,0,0,5">
                        <Run Text="⚠️ Produtos com estoque baixo: " FontWeight="SemiBold"/>
                        <Run Text="{Binding ResumoMensal.ProdutosEstoqueBaixo, Mode=OneWay}" Foreground="#E74C3C" FontWeight="Bold"/>
                    </TextBlock>

                    <TextBlock Margin="0,0,0,5">
                        <Run Text="📋 OS Aguardando Peças: " FontWeight="SemiBold"/>
                        <Run Text="{Binding ResumoMensal.OSAguardandoPecas, Mode=OneWay}" Foreground="#E67E22" FontWeight="Bold"/>
                    </TextBlock>

                    <TextBlock>
                        <Run Text="📋 OS Abertas: " FontWeight="SemiBold"/>
                        <Run Text="{Binding ResumoMensal.OSAbertas, Mode=OneWay}" Foreground="#0A246A" FontWeight="Bold"/>
                    </TextBlock>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>