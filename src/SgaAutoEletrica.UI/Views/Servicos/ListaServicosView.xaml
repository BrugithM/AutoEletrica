<UserControl x:Class="SgaAutoEletrica.UI.Views.Servicos.ListaServicosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra de Ferramentas -->
        <Border Padding="5" Background="#DCE7F5">
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal">

            <Button Content="➕ Novo"
                    Command="{Binding NovoServicoCommand}"
                    Width="70"
                    Style="{StaticResource BotaoToolbarStyle}"/>

            <Button Content="✏️ Editar"
                    Command="{Binding EditarServicoCommand}"
                    Width="75"
                    Style="{StaticResource BotaoToolbarStyle}"/>

            <Button Content="{Binding TextoBotaoDesativar}"
                    Command="{Binding DesativarServicoCommand}"
                    Width="95"
                    Style="{StaticResource BotaoToolbarStyle}"/>

            <Button Content="⟳ Atualizar"
                    Command="{Binding AtualizarCommand}"
                    Width="85"
                    Style="{StaticResource BotaoToolbarStyle}"/>

            <TextBlock Text="Pesquisar:"
                       VerticalAlignment="Center"
                       Margin="0,0,5,0"
                       FontSize="12"/>

            <TextBox Text="{Binding TermoBusca, UpdateSourceTrigger=PropertyChanged}"
                     Width="180"
                     Height="28"
                     VerticalContentAlignment="Center"
                     Padding="4"
                     Margin="0,0,2,0"/>

            <Button Content="⌕"
                    Command="{Binding BuscarCommand}"
                    Width="28"
                    Style="{StaticResource BotaoToolbarStyle}"/>
        </StackPanel>
        </Border>

        <TextBlock Grid.Row="1"
                   Text="Serviços Cadastrados na Oficina:"
                   FontWeight="Bold"
                   FontSize="14"
                   Margin="10"/>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Servicos}"
                  SelectedItem="{Binding ServicoSelecionado}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  Margin="10"
                  RowStyle="{StaticResource InativoRowStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Serviço"
                                    Binding="{Binding Nome}"
                                    Width="*"/>
                <DataGridTextColumn Header="Descrição"
                                    Binding="{Binding Descricao}"
                                    Width="250"/>
                <DataGridTextColumn Header="Preço Padrão (R$)"
                                    Binding="{Binding PrecoPadrao, StringFormat=C2}"
                                    Width="150"/>
                <DataGridTextColumn Header="Status"
                                    Width="100">
                    <DataGridTextColumn.Binding>
                        <Binding Path="Ativo"
                                 Converter="{StaticResource BoolParaStatusConverter}"/>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>