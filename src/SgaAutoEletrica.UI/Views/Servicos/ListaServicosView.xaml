<UserControl x:Class="SgaAutoEletrica.UI.Views.Servicos.ListaServicosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra de Ferramentas -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="➕ Novo" Command="{Binding NovoServicoCommand}"
                    Width="90" Height="32" Margin="0,0,5,0" Background="#27AE60" Foreground="White"/>
            <Button Content="✏️ Editar" Command="{Binding EditarServicoCommand}"
                    Width="90" Height="32" Margin="0,0,5,0" Background="#3498DB" Foreground="White"/>
            <Button Content="{Binding TextoBotaoDesativar}" Command="{Binding DesativarServicoCommand}"
                    Width="120" Height="32" Margin="0,0,5,0" Background="#E67E22" Foreground="White"/>
            <Button Content="🔄 Atualizar" Command="{Binding AtualizarCommand}"
                    Width="100" Height="32" Margin="0,0,20,0"/>

            <TextBlock Text="Pesquisar:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
            <TextBox Text="{Binding TermoBusca, UpdateSourceTrigger=PropertyChanged}"
                     Width="250" Height="32" VerticalContentAlignment="Center" Padding="5"
                     Margin="0,0,5,0"/>
            <Button Content="🔍" Command="{Binding BuscarCommand}" Width="40" Height="32"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="Serviços Cadastrados na Oficina:" FontWeight="Bold" FontSize="14" 
                   Margin="0,0,0,5"/>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Servicos}"
                  SelectedItem="{Binding ServicoSelecionado}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  RowStyle="{StaticResource ServicoInativoRowStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Serviço" Binding="{Binding Nome}" Width="*"/>
                <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="250"/>
                <DataGridTextColumn Header="Preço Padrão (R$)" 
                                    Binding="{Binding PrecoPadrao, StringFormat=C2}" Width="150"/>
                <DataGridTextColumn Header="Status" Width="100">
                    <DataGridTextColumn.Binding>
                        <Binding Path="Ativo" Converter="{StaticResource BoolParaStatusConverter}"/>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>