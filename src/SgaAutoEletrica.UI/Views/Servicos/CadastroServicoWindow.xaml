<Window x:Class="SgaAutoEletrica.UI.Views.Servicos.CadastroServicoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Titulo}" Height="350" Width="450"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Dados do Serviço" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

            <TextBlock Text="Nome:"/>
            <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,0,0,10"/>

            <TextBlock Text="Descrição:"/>
            <TextBox Text="{Binding Descricao, UpdateSourceTrigger=PropertyChanged}" 
                     Height="60" Margin="0,0,0,10" TextWrapping="Wrap" AcceptsReturn="True"/>

            <TextBlock Text="Preço Padrão (R$):"/>
            <TextBox Text="{Binding PrecoPadrao, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,0,0,15"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Salvar" Width="100" Height="30" Margin="0,0,10,0" Click="BtnSalvar_Click"/>
                <Button Content="Cancelar" Width="100" Height="30" Click="BtnCancelar_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>