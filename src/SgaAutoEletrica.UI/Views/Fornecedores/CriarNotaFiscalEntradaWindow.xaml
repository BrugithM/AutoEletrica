<Window x:Class="SgaAutoEletrica.UI.Views.Fornecedores.CriarNotaFiscalEntradaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nota Fiscal de Entrada" Height="720" Width="850"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Dados da Nota Fiscal -->
        <GroupBox Grid.Row="0" Header="Dados da Nota de Entrada" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Número da NF"/>
                        <TextBox Text="{Binding Numero, UpdateSourceTrigger=PropertyChanged}"
                                 Height="26" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Fornecedor"/>
                        <ComboBox ItemsSource="{Binding Fornecedores}"
                                  SelectedItem="{Binding FornecedorSelecionado}"
                                  DisplayMemberPath="NomeEmpresa"
                                  Height="26" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Data de Entrada"/>
                        <DatePicker SelectedDate="{Binding DataEntrada}"
                                    Height="26" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="CNPJ do Fornecedor" Margin="0,8,0,0"/>
                <TextBlock Text="{Binding CnpjFornecedor}" FontWeight="SemiBold" Margin="0,2,0,0"/>

                <TextBlock Text="Observação" Margin="0,8,0,0"/>
                <TextBox Text="{Binding Observacao, UpdateSourceTrigger=PropertyChanged}"
                         Height="50" TextWrapping="Wrap" AcceptsReturn="True"
                         Margin="0,2,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- Itens -->
        <GroupBox Grid.Row="1" Header="Itens" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Produto"/>
                        <ComboBox ItemsSource="{Binding PecasDisponiveis}"
                                  SelectedItem="{Binding PecaSelecionada}"
                                  DisplayMemberPath="Nome"
                                  Height="26" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,5,0">
                        <TextBlock Text="Qtd"/>
                        <TextBox Text="{Binding Quantidade, UpdateSourceTrigger=PropertyChanged}"
                                 Height="26" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,5,0">
                        <TextBlock Text="Valor Unitário"/>
                        <TextBox Text="{Binding ValorUnitario, UpdateSourceTrigger=LostFocus, Converter={StaticResource DecimalConverter}}"
                                 Height="26" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="3" Content="➕ Adicionar"
                            Command="{Binding AdicionarItemCommand}"
                            Style="{StaticResource BotaoPadraoStyle}"
                            Width="120" Height="26" VerticalAlignment="Bottom"
                            />
                </Grid>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding ItensNF}"
                          SelectedItem="{Binding ItemSelecionado}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Produto" Binding="{Binding NomePeca}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Qtd" 
                                            Binding="{Binding Quantidade, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                        <DataGridTextColumn Header="Valor Unit. (R$)" 
                                            Binding="{Binding ValorUnitario, UpdateSourceTrigger=LostFocus, StringFormat=N2}" Width="150"/>
                        <DataGridTextColumn Header="Subtotal (R$)" 
                                            Binding="{Binding ValorTotal, StringFormat=C2}" Width="150" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Button Grid.Row="2" Content="➖ Remover Selecionado"
                        Command="{Binding RemoverItemCommand}"
                        Width="180" HorizontalAlignment="Left"
                        Style="{StaticResource BotaoPadraoStyle}"/>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Resumo de Valores" Padding="10" Margin="0,0,0,10">
            <Grid>
                <TextBlock Text="TOTAL:" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ValorTotal, StringFormat=C2}" 
                           FontSize="22" FontWeight="Bold" Foreground="#0A246A"
                           HorizontalAlignment="Right"/>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Salvar NF" Click="BtnSalvar_Click"
                    Width="130" Margin="0,0,10,0"
                    Style="{StaticResource BotaoPadraoStyle}"/>
            <Button Content="Cancelar" Width="120" Style="{StaticResource BotaoPadraoStyle}" Click="BtnCancelar_Click"/>
        </StackPanel>
    </Grid>
</Window>