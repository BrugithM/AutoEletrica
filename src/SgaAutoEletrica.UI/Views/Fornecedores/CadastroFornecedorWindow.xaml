<Window x:Class="SgaAutoEletrica.UI.Views.Fornecedores.CadastroFornecedorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Titulo}" Height="350" Width="450"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Dados do Fornecedor" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

            <TextBlock Text="Nome da Empresa:"/>
            <TextBox Text="{Binding NomeEmpresa, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,0,0,10"/>

            <TextBlock Text="CNPJ:"/>
            <TextBox Text="{Binding Cnpj, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,0,0,10"/>

            <TextBlock Text="Telefone:"/>
            <TextBox Text="{Binding Telefone, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,0,0,10"/>

            <TextBlock Text="Contato (pessoa):"/>
            <TextBox Text="{Binding Contato, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,0,0,15"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Salvar" Width="100" Height="30" Margin="0,0,10,0" Click="BtnSalvar_Click"/>
                <Button Content="Cancelar" Width="100" Height="30" Click="BtnCancelar_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>