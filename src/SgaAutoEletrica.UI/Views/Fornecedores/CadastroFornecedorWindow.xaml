<Window x:Class="SgaAutoEletrica.UI.Views.Fornecedores.CadastroFornecedorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Titulo}"
        Height="340"
        Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                Text="Ficha Cadastral:"
                FontWeight="Bold"
                FontSize="13"
                Margin="0,0,0,10"/>

        <GroupBox Grid.Row="1"
                Header="Fornecedor"
                Padding="10">
            <StackPanel>
                <TextBlock Text="Nome da Empresa"/>
                <TextBox Text="{Binding NomeEmpresa, UpdateSourceTrigger=PropertyChanged}"
                         Height="26"
                        Margin="0,2,0,10"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="CNPJ"/>
                        <TextBox x:Name="TxtCnpj"
                                 Text="{Binding Cnpj, UpdateSourceTrigger=PropertyChanged}"
                                 Height="26"
                                Margin="0,2,0,0"
                                 LostFocus="TxtCnpj_LostFocus"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Telefone"/>
                        <TextBox x:Name="TxtTelefone"
                                 Text="{Binding Telefone, UpdateSourceTrigger=PropertyChanged}"
                                 Height="26"
                                Margin="0,2,0,0"
                                 LostFocus="TxtTelefone_LostFocus"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Contato (pessoa)"/>
                <TextBox Text="{Binding Contato, UpdateSourceTrigger=PropertyChanged}"
                         Height="26"
                        Margin="0,2,0,0"/>
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,15,0,0">
            <Button Content="Salvar"
                    Width="90"
                    Style="{StaticResource BotaoPadraoStyle}"
                    Margin="0,0,10,0"
                    Click="BtnSalvar_Click"/>
            <Button Content="Limpar"
                    Width="90"
                    Style="{StaticResource BotaoPadraoStyle}"
                    Click="BtnLimpar_Click"/>
        </StackPanel>
    </Grid>
</Window>