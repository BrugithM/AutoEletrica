<Window x:Class="SgaAutoEletrica.UI.Views.Fornecedores.DetalhesNotaFiscalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Titulo}" Height="650" Width="850" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="Dados da Nota Fiscal" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Número:" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Numero}" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Fornecedor:" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Fornecedor}" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Data:" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding DataEntrada}" FontSize="14"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="Observação:" FontWeight="SemiBold" Margin="0,10,0,0"/>
                <TextBlock Text="{Binding Observacao}" TextWrapping="Wrap"/>
            </StackPanel>
        </GroupBox>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Itens}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Produto" Binding="{Binding NomePeca}" Width="*"/>
                <DataGridTextColumn Header="Qtd" Binding="{Binding Quantidade, StringFormat={}{0:0.###}}" Width="80"/>
                <DataGridTextColumn Header="Valor Unit. (R$)" Binding="{Binding ValorUnitario, StringFormat=C2}" Width="120"/>
                <DataGridTextColumn Header="Subtotal (R$)" Binding="{Binding ValorTotal, StringFormat=C2}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <GroupBox Grid.Row="2"
                  Header="Resumo de Valores"
                  Padding="10"
                  Margin="0,0,0,10">
            <Grid>
                <TextBlock Text="TOTAL:"
                           FontSize="18"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ValorTotal, StringFormat=C2}"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#0A246A"
                           HorizontalAlignment="Right"/>
            </Grid>
        </GroupBox>
            <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
             <Button Content="Editar NF" Command="{Binding EditarCommand}" Width="120" HorizontalAlignment="Center" Style="{StaticResource BotaoPadraoStyle}"/>
        </StackPanel>
    </Grid>
</Window>