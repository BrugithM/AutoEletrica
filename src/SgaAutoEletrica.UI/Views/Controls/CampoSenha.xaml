<UserControl x:Class="SgaAutoEletrica.UI.Views.Controls.CampoSenha"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="root">
    <Border BorderBrush="#999" BorderThickness="1" Background="White">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- PasswordBox (senha escondida) -->
            <PasswordBox Grid.Column="0"
                         x:Name="PwdSenha"
                         Height="{Binding ElementName=root, Path=Altura}"
                         FontSize="14"
                         Padding="5,0,0,0"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalContentAlignment="Center"
                         PasswordChanged="PwdSenha_PasswordChanged"
                         Visibility="{Binding ElementName=root, Path=SenhaVisivel, Converter={StaticResource InverterBoolParaVisibilidade}}"/>

            <!-- TextBox (senha visível) -->
            <TextBox Grid.Column="0"
                     x:Name="TxtSenha"
                     Height="{Binding ElementName=root, Path=Altura}"
                     FontSize="14"
                     Padding="5,0,0,0"
                     BorderThickness="0"
                     Background="Transparent"
                     VerticalContentAlignment="Center"
                     TextChanged="TxtSenha_TextChanged"
                     Visibility="{Binding ElementName=root, Path=SenhaVisivel, Converter={StaticResource BoolParaVisibilidade}}"/>

            <!-- Botão do olho -->
            <Button Grid.Column="1"
                    x:Name="BtnOlho"
                    Content="👁"
                    Width="28"
                    Height="{Binding ElementName=root, Path=Altura}"
                    FontSize="14"
                    Cursor="Hand"
                    BorderThickness="0"
                    Background="Transparent"
                    Padding="0"
                    ToolTip="Mostrar/ocultar senha"
                    Click="BtnOlho_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent" Padding="0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.6"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</UserControl>