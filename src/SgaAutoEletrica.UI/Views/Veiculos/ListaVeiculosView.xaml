<UserControl x:Class="SgaAutoEletrica.UI.Views.Veiculos.ListaVeiculosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barra de Ferramentas -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,10">
            <Button Content="➕ Novo"
                    Command="{Binding NovoVeiculoCommand}"
                    Width="90"
                    Height="32"
                    Margin="0,0,5,0"
                    Background="#27AE60"
                    Foreground="White"/>
            <Button Content="✏️ Editar"
                    Command="{Binding EditarVeiculoCommand}"
                    Width="90"
                    Height="32"
                    Margin="0,0,5,0"
                    Background="#3498DB"
                    Foreground="White"/>
            <Button Content="🗑️ Excluir"
                    Command="{Binding ExcluirVeiculoCommand}"
                    Width="90"
                    Height="32"
                    Margin="0,0,5,0"
                    Background="#E74C3C"
                    Foreground="White"/>
            <Button Content="🔄 Atualizar"
                    Command="{Binding AtualizarCommand}"
                    Width="100"
                    Height="32"
                    Margin="0,0,20,0"/>

            <TextBlock Text="Pesquisar:"
                       VerticalAlignment="Center"
                       Margin="0,0,5,0"
                       FontWeight="SemiBold"/>
            <TextBox Text="{Binding TermoBusca, UpdateSourceTrigger=PropertyChanged}"
                     Width="250"
                     Height="32"
                     VerticalContentAlignment="Center"
                     Padding="5"
                     Margin="0,0,5,0"/>
            <Button Content="🔍"
                    Command="{Binding BuscarCommand}"
                    Width="40"
                    Height="32"/>
        </StackPanel>

        <!-- Painel do Proprietário (só aparece se veículo selecionado) -->
        <Border Grid.Row="1"
                Background="#F5F5F5"
                Padding="10"
                Margin="0,0,0,10"
                Visibility="{Binding TemVeiculoSelecionado, Converter={StaticResource BoolParaVisibilidade}}">
            <StackPanel>
                <TextBlock Text="Associação do Proprietário / Cliente:"
                        FontWeight="Bold"
                        Margin="0,0,0,5"/>
                <TextBlock Text="{Binding ClienteNome, StringFormat=Cliente: {0}, Mode=OneWay}"/>
                <TextBlock Text="{Binding ClienteCpf, StringFormat=CPF: {0}, Mode=OneWay}"/>
                <TextBlock Text="{Binding ClienteTelefone, StringFormat=Telefone: {0}, Mode=OneWay}"/>
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="2"
                   Text="Veículos Cadastrados:"
                   FontWeight="Bold"
                   FontSize="14"
                   Margin="0,5,0,5"/>

        <!-- Grid de Veículos -->
        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding Veiculos}"
                  SelectedItem="{Binding VeiculoSelecionado}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Placa"
                                    Binding="{Binding Placa}"
                                    Width="100"/>
                <DataGridTextColumn Header="Marca"
                                    Binding="{Binding Marca}"
                                    Width="120"/>
                <DataGridTextColumn Header="Modelo"
                                    Binding="{Binding Modelo}"
                                    Width="150"/>
                <DataGridTextColumn Header="Ano"
                                    Binding="{Binding Ano}"
                                    Width="70"/>
                <DataGridTextColumn Header="Versão"
                                    Binding="{Binding Versao}"
                                    Width="120"/>
                <DataGridTextColumn Header="Motor"
                                    Binding="{Binding Motor}"
                                    Width="100"/>
                <DataGridTextColumn Header="Tipo Motor"
                                    Binding="{Binding TipoMotor}"
                                    Width="100"/>
                <DataGridTextColumn Header="Cor"
                                    Binding="{Binding Cor}"
                                    Width="100"/>
                <DataGridTextColumn Header="Observação"
                                    Binding="{Binding Observacao}"
                                    Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Botões Inferiores -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="🔗 Vincular Novo Veículo"
                    Command="{Binding NovoVeiculoCommand}"
                    Width="200"
                    Height="35"
                    Margin="0,0,10,0"
                    Background="#3498DB"
                    Foreground="White"
                    FontWeight="SemiBold"/>
            <Button Content="📄 NFs Vinculadas"
                    Command="{Binding NFsVinculadasCommand}"
                    Width="160"
                    Height="35"
                    Margin="0,0,10,0"
                    Background="#8E44AD"
                    Foreground="White"
                    FontWeight="SemiBold"/>
            <Button Content="📋 Criar OS"
                    Command="{Binding CriarOSCommand}"
                    Width="130"
                    Height="35"
                    Background="#27AE60"
                    Foreground="White"
                    FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</UserControl>