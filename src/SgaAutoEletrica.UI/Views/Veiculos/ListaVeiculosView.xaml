<UserControl x:Class="SgaAutoEletrica.UI.Views.Veiculos.ListaVeiculosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Veículos" FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" 
                     Text="{Binding TermoBusca, UpdateSourceTrigger=PropertyChanged}"
                     Height="30" FontSize="14" Padding="5" Margin="0,0,10,0"
                     ToolTip="Busca por placa, modelo, marca ou cliente"/>

            <Button Grid.Column="1" Content="Buscar" Command="{Binding BuscarCommand}"
                    Width="80" Height="30" Margin="0,0,10,0"/>

            <Button Grid.Column="2" Content="Limpar" Command="{Binding LimparCommand}"
                    Width="80" Height="30" Margin="0,0,10,0"/>

            <Button Grid.Column="3" Content="+ Novo Veículo" Command="{Binding NovoVeiculoCommand}"
                    Width="120" Height="30" Background="#27AE60" Foreground="White"/>
        </Grid>

        <DataGrid Grid.Row="2" 
                  ItemsSource="{Binding Veiculos}"
                  SelectedItem="{Binding VeiculoSelecionado}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Placa" Binding="{Binding Placa}" Width="100"/>
                <DataGridTextColumn Header="Marca" Binding="{Binding Marca}" Width="130"/>
                <DataGridTextColumn Header="Modelo" Binding="{Binding Modelo}" Width="150"/>
                <DataGridTextColumn Header="Ano" Binding="{Binding Ano}" Width="70"/>
                <DataGridTextColumn Header="Versão" Binding="{Binding Versao}" Width="120"/>
                <DataGridTextColumn Header="Motor" Binding="{Binding Motor}" Width="100"/>
                <DataGridTextColumn Header="Tipo Motor" Binding="{Binding TipoMotor}" Width="100"/>
                <DataGridTextColumn Header="Cor" Binding="{Binding Cor}" Width="80"/>
                <DataGridTextColumn Header="Cliente" Binding="{Binding NomeCliente}" Width="200"/>
                <DataGridTextColumn Header="Observação" Binding="{Binding Observacao}" Width="200"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Editar" Command="{Binding EditarVeiculoCommand}" 
                    Width="80" Height="30" Margin="0,0,10,0"/>
            <Button Content="Excluir" Command="{Binding ExcluirVeiculoCommand}" 
                    Width="80" Height="30" Background="#C0392B" Foreground="White"/>
        </StackPanel>
    </Grid>
</UserControl>