<UserControl x:Class="SgaAutoEletrica.UI.Views.Veiculos.ListaVeiculosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
             <UserControl.InputBindings>
        <KeyBinding Key="F5"
                    Command="{Binding AtualizarCommand}"/>
    </UserControl.InputBindings>
        <Grid Margin="0">
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Barra de Ferramentas -->
                <Border Padding="5"
                        Background="#DCE7F5">
                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal">
                                <Button Content="➕ Novo"
                                        Command="{Binding NovoVeiculoCommand}"
                                        Width="70"
                                        Style="{StaticResource BotaoToolbarStyle}"/>
                                <Button Content="✏️ Editar"
                                        Command="{Binding EditarVeiculoCommand}"
                                        Width="75"
                                        Style="{StaticResource BotaoToolbarStyle}"/>
                                <Button Content="{Binding TextoBotaoDesativar}"
                                        Command="{Binding DesativarVeiculoCommand}"
                                        Width="95"
                                        Style="{StaticResource BotaoToolbarStyle}"/>
                                <Button Content="⟳ Atualizar"
                                        Command="{Binding AtualizarCommand}"
                                        Width="85"
                                        Style="{StaticResource BotaoToolbarStyle}"/>
                        </StackPanel>
                </Border>

                <!-- Alternador de modo -->
                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            Margin="10">
                        <Button Content="⌕ Busca Avançada"
                                Command="{Binding AlternarModoBuscaCommand}"
                                Width="160"
                                Style="{StaticResource BotaoPadraoStyle}"/>
                </StackPanel>

                <!-- Busca Rápida -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            Margin="10,0,10,10"
                            Visibility="{Binding ModoBuscaRapida, Converter={StaticResource BoolParaVisibilidade}}">
                        <TextBlock Text="Pesquisar:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,5,0"
                                   FontSize="12"/>
                        <TextBox Text="{Binding TermoBusca, UpdateSourceTrigger=PropertyChanged}"
                                 Width="180"
                                 Height="28"
                                 VerticalContentAlignment="Center"
                                 Padding="4"
                                 Margin="0,0,2,0"
                                 ToolTip="Placa, Modelo, Marca ou Cliente"/>
                        <Button Content="⌕"
                                Command="{Binding BuscarCommand}"
                                Width="28"
                                Margin="0,0,10,0"
                                IsDefault="True"
                                Style="{StaticResource BotaoToolbarStyle}"
                                Background="Transparent"/>

                        <CheckBox Content="Mostrar inativos"
                                  IsChecked="{Binding MostrarInativos}"
                                  VerticalAlignment="Center"
                                  FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Busca Avançada -->
                <Border Grid.Row="2"
                        Background="#F5F5F5"
                        Padding="10"
                        Margin="10,0,10,10"
                        CornerRadius="5"
                        Visibility="{Binding ModoBuscaAvancada, Converter={StaticResource BoolParaVisibilidade}}">
                        <StackPanel>
                                <Grid>
                                        <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0"
                                                    Margin="0,0,5,0">
                                                <TextBlock Text="Placa:"
                                                           FontWeight="SemiBold"
                                                           Margin="0,0,0,3"/>
                                                <TextBox Text="{Binding BuscaPlaca, UpdateSourceTrigger=PropertyChanged}"
                                                         Height="28"
                                                         Padding="5"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    Margin="0,0,5,0">
                                                <TextBlock Text="Modelo:"
                                                           FontWeight="SemiBold"
                                                           Margin="0,0,0,3"/>
                                                <TextBox Text="{Binding BuscaModelo, UpdateSourceTrigger=PropertyChanged}"
                                                         Height="28"
                                                         Padding="5"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2"
                                                    Margin="0,0,5,0">
                                                <TextBlock Text="Marca:"
                                                           FontWeight="SemiBold"
                                                           Margin="0,0,0,3"/>
                                                <TextBox Text="{Binding BuscaMarca, UpdateSourceTrigger=PropertyChanged}"
                                                         Height="28"
                                                         Padding="5"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3">
                                                <TextBlock Text="Ano:"
                                                           FontWeight="SemiBold"
                                                           Margin="0,0,0,3"/>
                                                <TextBox Text="{Binding BuscaAno, UpdateSourceTrigger=PropertyChanged}"
                                                         Height="28"
                                                         Padding="5"/>
                                        </StackPanel>
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0"
                                                    Margin="0,0,5,0">
                                                <TextBlock Text="Nome do Cliente:"
                                                           FontWeight="SemiBold"
                                                           Margin="0,0,0,3"/>
                                                <TextBox Text="{Binding BuscaNomeCliente, UpdateSourceTrigger=PropertyChanged}"
                                                         Height="28"
                                                         Padding="5"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Bottom">
                                                <CheckBox Content="Mostrar inativos"
                                                          IsChecked="{Binding MostrarInativos}"
                                                          VerticalAlignment="Center"
                                                          FontWeight="SemiBold"
                                                          Margin="0,0,15,0"/>
                                                <Button Content="Limpar"
                                                        Command="{Binding LimparCommand}"
                                                        Width="80"
                                                        Margin="0,0,10,0"
                                                        Style="{StaticResource BotaoPadraoStyle}"/>
                                                <Button Content="⌕ Buscar"
                                                        Command="{Binding BuscarCommand}"
                                                        Width="90"
                                                        IsDefault="True"
                                                        Style="{StaticResource BotaoPadraoStyle}"/>
                                        </StackPanel>
                                </Grid>
                        </StackPanel>
                </Border>

                <!-- Grid de Veículos -->
                <DataGrid Grid.Row="3"
                          ItemsSource="{Binding Veiculos}"
                          SelectedItem="{Binding VeiculoSelecionado}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          Margin="10"
                          RowStyle="{StaticResource InativoRowStyle}">
                        <DataGrid.Columns>
                                <DataGridTextColumn Header="Placa"
                                                    Binding="{Binding Placa}"
                                                    Width="100"/>
                                <DataGridTextColumn Header="Marca"
                                                    Binding="{Binding Marca}"
                                                    Width="120"/>
                                <DataGridTextColumn Header="Modelo"
                                                    Binding="{Binding Modelo}"
                                                    Width="150"/>
                                <DataGridTextColumn Header="Ano"
                                                    Binding="{Binding Ano}"
                                                    Width="70"/>
                                <DataGridTextColumn Header="Versão"
                                                    Binding="{Binding Versao}"
                                                    Width="120"/>
                                <DataGridTextColumn Header="Motor"
                                                    Binding="{Binding Motor}"
                                                    Width="100"/>
                                <DataGridTextColumn Header="Tipo Motor"
                                                    Binding="{Binding TipoMotor}"
                                                    Width="100"/>
                                <DataGridTextColumn Header="Cor"
                                                    Binding="{Binding Cor}"
                                                    Width="100"/>
                                <DataGridTextColumn Header="Cliente"
                                                    Binding="{Binding NomeCliente}"
                                                    Width="200"/>
                                <DataGridTextColumn Header="Observação"
                                                    Binding="{Binding Observacao}"
                                                    Width="*"/>
                        </DataGrid.Columns>
                </DataGrid>

                <!-- Painel do Proprietário -->
                <Border Grid.Row="4"
                        Background="#F5F5F5"
                        Padding="10"
                        Margin="0,10,0,0"
                        Visibility="{Binding TemVeiculoSelecionado, Converter={StaticResource BoolParaVisibilidade}}">
                        <StackPanel>
                                <TextBlock Text="Associação do Proprietário / Cliente:"
                                           FontWeight="Bold"
                                           Margin="0,0,0,5"/>
                                <TextBlock>
                    <Run Text="Cliente: "
                                        FontWeight="SemiBold"/>
                    <Run Text="{Binding ClienteNome, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock>
                    <Run Text="CPF: "
                                        FontWeight="SemiBold"/>
                    <Run Text="{Binding ClienteCpf, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock>
                    <Run Text="Telefone: "
                                        FontWeight="SemiBold"/>
                    <Run Text="{Binding ClienteTelefone, Mode=OneWay}"/>
                                </TextBlock>
                        </StackPanel>
                </Border>

                <!-- Botões inferiores -->
                <StackPanel Grid.Row="6"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="10,5,10,10">
                        <Button Content="🔗 Vincular Novo Veículo"
                                Command="{Binding NovoVeiculoCommand}"
                                Width="160"
                                Style="{StaticResource BotaoPadraoStyle}"/>
                        <Button Content="📄 OS Vinculadas"
                                Command="{Binding OSVinculadasCommand}"
                                Width="140"
                                Style="{StaticResource BotaoPadraoStyle}"/>
                        <Button Content="📋 Criar OS"
                                Command="{Binding CriarOSCommand}"
                                Width="100"
                                Style="{StaticResource BotaoPadraoStyle}"/>
                </StackPanel>

                <!-- Rodapé com paginação -->
                <Border Grid.Row="7"
                        Background="#DCE7F5"
                        Padding="10,8"
                        Margin="0,10,0,0">
                        <Grid>
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding TextoPaginacao}"
                                           Foreground="Black"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"/>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal">
                                        <Button Content="◀ Anterior"
                                                Command="{Binding PaginaAnteriorCommand}"
                                                Width="100"
                                                Height="28"
                                                Margin="0,0,5,0"/>
                                        <Button Content="Próxima ▶"
                                                Command="{Binding ProximaPaginaCommand}"
                                                Width="100"
                                                Height="28"/>
                                </StackPanel>
                        </Grid>
                </Border>
        </Grid>
</UserControl>