<Window x:Class="SgaAutoEletrica.UI.Views.Veiculos.CadastroVeiculoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Titulo}"
        Height="620"
        Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Ficha Cadastral:"
                   FontWeight="Bold"
                   FontSize="13"
                   Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1">
            <!-- Cliente Associado -->
            <GroupBox Header="Cliente Associado"
                      Padding="10"
                      Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Nome Completo"/>
                    <ComboBox ItemsSource="{Binding Clientes}"
                              SelectedItem="{Binding ClienteSelecionado}"
                              DisplayMemberPath="NomeCompleto"
                              IsEditable="True"
                              IsTextSearchEnabled="True"
                              TextSearch.TextPath="NomeCompleto"
                              Height="26"
                              Margin="0,2,0,0"/>
                </StackPanel>
            </GroupBox>

            <!-- Detalhes do Veículo -->
            <GroupBox Header="Detalhes do Veículo Selecionado"
                      Padding="10">
                <StackPanel>
                    <!-- Placa / Marca -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Placa"/>
                            <TextBox Text="{Binding Placa, UpdateSourceTrigger=PropertyChanged}"
                                     Height="26"
                                     Margin="0,2,0,0"
                                     MaxLength="7"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Marca"/>
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding MarcasVeiculo}"
                                          SelectedItem="{Binding MarcaVeiculoSelecionada}"
                                          DisplayMemberPath="Nome"
                                          IsEditable="True"
                                          IsTextSearchEnabled="True"
                                          TextSearch.TextPath="Nome"
                                          Height="26"/>
                                <Button Grid.Column="1"
                                        Content="➕"
                                        Command="{Binding NovaMarcaVeiculoCommand}"
                                        Width="30"
                                        Style="{StaticResource BotaoPadraoStyle}"
                                        Margin="5,0,0,0"
                                        ToolTip="Nova Marca de Veículo"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Modelo / Ano -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Modelo"/>
                            <TextBox Text="{Binding Modelo, UpdateSourceTrigger=PropertyChanged}"
                                     Height="26"
                                     Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Ano"/>
                            <TextBox Text="{Binding Ano, UpdateSourceTrigger=PropertyChanged}"
                                     Height="26"
                                     Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Versão / Motor -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Versão"/>
                            <TextBox Text="{Binding Versao, UpdateSourceTrigger=PropertyChanged}"
                                     Height="26"
                                     Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Motor"/>
                            <TextBox Text="{Binding Motor, UpdateSourceTrigger=PropertyChanged}"
                                     Height="26"
                                     Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Tipo Motor / Cor -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Tipo Motor"/>
                            <ComboBox ItemsSource="{Binding TiposMotorDisponiveis}"
                                      SelectedItem="{Binding TipoMotor}"
                                      Height="26"
                                      Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Cor"/>
                            <TextBox Text="{Binding Cor, UpdateSourceTrigger=PropertyChanged}"
                                     Height="26"
                                     Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Observações -->
                    <TextBlock Text="Observações Gerais"/>
                    <Grid Margin="0,2,0,0">
                        <TextBox Text="{Binding Observacao, UpdateSourceTrigger=PropertyChanged}"
                                 Height="80"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 MaxLength="500"/>
                        <TextBlock Text="{Binding ObservacaoLength, StringFormat={}{0}/500}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,5,3"
                                   Foreground="#888"
                                   FontSize="10"/>
                    </Grid>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button Content="Salvar"
                    Width="90"
                    Style="{StaticResource BotaoPadraoStyle}"
                    Margin="0,0,10,0"
                    IsDefault="True"
                    Click="BtnSalvar_Click"/>
            <Button Content="Limpar"
                    Width="90"
                    Style="{StaticResource BotaoPadraoStyle}"
                    Click="BtnLimpar_Click"/>
        </StackPanel>
    </Grid>
</Window>