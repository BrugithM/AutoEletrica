<Window x:Class="SgaAutoEletrica.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SGA - Sistema de Gestão para Autoelétrica"
        Height="750"
        Width="1200"
        WindowStartupLocation="CenterScreen">

        <Grid>
                <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <!-- Menu principal -->
                        <RowDefinition Height="80"/>
                        <!-- Barra de atalhos -->
                        <RowDefinition Height="*"/>
                        <!-- Área de conteúdo -->
                        <RowDefinition Height="30"/>
                        <!-- Rodapé -->
                </Grid.RowDefinitions>

                <!-- MENU PRINCIPAL -->
                <Menu Grid.Row="0"
                      Background="#2C3E50"
                      Foreground="White">
                        <MenuItem Header="Cadastro">
                                <MenuItem Header="Clientes"
                                          Click="BtnClientes_Click"
                                          Style="{StaticResource SubMenuItemStyle}"/>
                                <MenuItem Header="Veículos"
                                          Click="BtnVeiculos_Click"
                                          Style="{StaticResource SubMenuItemStyle}"/>
                                <MenuItem Header="Fornecedores"
                                          Click="BtnFornecedores_Click"
                                          Style="{StaticResource SubMenuItemStyle}"/>
                                <MenuItem Header="Categorias"
                                          Click="BtnCategorias_Click"
                                          Style="{StaticResource SubMenuItemStyle}"/>
                        </MenuItem>
                        <MenuItem Header="Estoque">
                                <MenuItem Header="Peças"
                                          Click="BtnPecas_Click"
                                          Style="{StaticResource SubMenuItemStyle}"/>
                                <MenuItem Header="Movimentação de Estoque"
                                          Click="BtnMovEstoque_Click"
                                          Style="{StaticResource SubMenuItemStyle}"/>
                                <MenuItem Header="Nota de Entrada"
                                          Click="BtnNotaEntrada_Click"
                                          Style="{StaticResource SubMenuItemStyle}"/>
                        </MenuItem>
                        <MenuItem Header="Fiscal">
                                <MenuItem Header="NF Saída"
                                          Click="BtnNFSaida_Click"
                                          Style="{StaticResource SubMenuItemStyle}"/>
                                <MenuItem Header="Buscar Notas Emitidas"
                                          Click="BtnBuscarNotasEmitidas_Click"
                                          Style="{StaticResource SubMenuItemStyle}"/>
                                <MenuItem Header="Buscar Notas Entrada"
                                          Click="BtnBuscarNotasEntrada_Click"
                                          Style="{StaticResource SubMenuItemStyle}"/>
                                <MenuItem Header="Buscar Produtos"
                                          Click="BtnBuscarProdutos_Click"
                                          Style="{StaticResource SubMenuItemStyle}"/>
                        </MenuItem>
                        <MenuItem Header="Ordem de Serviço">
                                <MenuItem Header="Criar OS"
                                          Click="BtnCriarOS_Click"
                                          Style="{StaticResource SubMenuItemStyle}"/>
                                <MenuItem Header="Listar OS"
                                          Click="BtnOS_Click"
                                          Style="{StaticResource SubMenuItemStyle}"/>
                        </MenuItem>
                        <MenuItem Header="Configurações">
                                <MenuItem Header="Empresa"
                                          Click="BtnConfigEmpresa_Click"
                                          Style="{StaticResource SubMenuItemStyle}"/>
                                <MenuItem Header="Impressoras"
                                          Click="BtnConfigImpressoras_Click"
                                          Style="{StaticResource SubMenuItemStyle}"/>
                                <MenuItem Header="Backup"
                                          Click="BtnBackup_Click"
                                          Style="{StaticResource SubMenuItemStyle}"/>
                        </MenuItem>
                </Menu>

                <!-- BARRA DE ATALHOS -->
                <Border Grid.Row="1"
                        Background="#ECF0F1"
                        BorderBrush="#BDC3C7"
                        BorderThickness="0,0,0,1">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal"
                                            Margin="10,5">
                                        <Button Click="BtnClientes_Click"
                                                Style="{StaticResource AtalhoButtonStyle}"
                                                Tag="👤">
                                                <StackPanel>
                                                        <TextBlock Text="👤"
                                                                   FontSize="24"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Cliente"
                                                                   FontSize="11"
                                                                   HorizontalAlignment="Center"/>
                                                </StackPanel>
                                        </Button>
                                        <Button Click="BtnVeiculos_Click"
                                                Style="{StaticResource AtalhoButtonStyle}"
                                                Tag="🚗">
                                                <StackPanel>
                                                        <TextBlock Text="🚗"
                                                                   FontSize="24"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Veículos"
                                                                   FontSize="11"
                                                                   HorizontalAlignment="Center"/>
                                                </StackPanel>
                                        </Button>
                                        <Button Click="BtnPecas_Click"
                                                Style="{StaticResource AtalhoButtonStyle}"
                                                Tag="🔧">
                                                <StackPanel>
                                                        <TextBlock Text="🔧"
                                                                   FontSize="24"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Peças"
                                                                   FontSize="11"
                                                                   HorizontalAlignment="Center"/>
                                                </StackPanel>
                                        </Button>
                                        <Button Click="BtnServicos_Click"
                                                Style="{StaticResource AtalhoButtonStyle}"
                                                Tag="🛠️">
                                                <StackPanel>
                                                        <TextBlock Text="🛠️"
                                                                   FontSize="24"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Serviços"
                                                                   FontSize="11"
                                                                   HorizontalAlignment="Center"/>
                                                </StackPanel>
                                        </Button>
                                        <Button Click="BtnFornecedores_Click"
                                                Style="{StaticResource AtalhoButtonStyle}"
                                                Tag="🏭">
                                                <StackPanel>
                                                        <TextBlock Text="🏭"
                                                                   FontSize="24"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Fornecedor"
                                                                   FontSize="11"
                                                                   HorizontalAlignment="Center"/>
                                                </StackPanel>
                                        </Button>
                                        <Button Click="BtnNotaEntrada_Click"
                                                Style="{StaticResource AtalhoButtonStyle}"
                                                Tag="📥">
                                                <StackPanel>
                                                        <TextBlock Text="📥"
                                                                   FontSize="24"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Nota Entrada"
                                                                   FontSize="11"
                                                                   HorizontalAlignment="Center"/>
                                                </StackPanel>
                                        </Button>
                                        <Button Click="BtnCriarOS_Click"
                                                Style="{StaticResource AtalhoButtonStyle}"
                                                Tag="📋">
                                                <StackPanel>
                                                        <TextBlock Text="📋"
                                                                   FontSize="24"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Criar OS"
                                                                   FontSize="11"
                                                                   HorizontalAlignment="Center"/>
                                                </StackPanel>
                                        </Button>
                                        <Button Click="BtnNFSaida_Click"
                                                Style="{StaticResource AtalhoButtonStyle}"
                                                Tag="📄">
                                                <StackPanel>
                                                        <TextBlock Text="📄"
                                                                   FontSize="24"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Text="NF Saída"
                                                                   FontSize="11"
                                                                   HorizontalAlignment="Center"/>
                                                </StackPanel>
                                        </Button>
                                        <Button Click="BtnBuscarCliente_Click"
                                                Style="{StaticResource AtalhoButtonStyle}"
                                                Tag="🔍">
                                                <StackPanel>
                                                        <TextBlock Text="🔍"
                                                                   FontSize="24"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Buscar Cliente"
                                                                   FontSize="11"
                                                                   HorizontalAlignment="Center"
                                                                   TextWrapping="Wrap"
                                                                   MaxWidth="80"/>
                                                </StackPanel>
                                        </Button>
                                        <Button Click="BtnBuscarVeiculo_Click"
                                                Style="{StaticResource AtalhoButtonStyle}"
                                                Tag="🔍">
                                                <StackPanel>
                                                        <TextBlock Text="🔍"
                                                                   FontSize="24"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Buscar Veículo"
                                                                   FontSize="11"
                                                                   TextWrapping="Wrap"
                                                                   HorizontalAlignment="Center"
                                                                   MaxWidth="80"/>
                                                </StackPanel>
                                        </Button>
                                        <Button Click="BtnBuscarProdutos_Click"
                                                Style="{StaticResource AtalhoButtonStyle}"
                                                Tag="🔍">
                                                <StackPanel>
                                                        <TextBlock Text="🔍"
                                                                   FontSize="24"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Buscar Peça"
                                                                   FontSize="11"
                                                                   TextWrapping="Wrap"
                                                                   HorizontalAlignment="Center"
                                                                   MaxWidth="80"/>
                                                </StackPanel>
                                        </Button>
                                        <Button Click="BtnBuscarNotasEmitidas_Click"
                                                Style="{StaticResource AtalhoButtonStyle}"
                                                Tag="🔍">
                                                <StackPanel>
                                                        <TextBlock Text="🔍"
                                                                   FontSize="24"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Buscar Notas Fiscais"
                                                                   FontSize="11"
                                                                   TextWrapping="Wrap"
                                                                   HorizontalAlignment="Center"
                                                                   MaxWidth="80"/>
                                                </StackPanel>
                                        </Button>
                                        <Button Click="BtnBuscarNotasEntrada_Click"
                                                Style="{StaticResource AtalhoButtonStyle}"
                                                Tag="🔍">
                                                <StackPanel>
                                                        <TextBlock Text="🔍"
                                                                   FontSize="24"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Buscar Notas de Entrada"
                                                                   FontSize="11"
                                                                   HorizontalAlignment="Center"
                                                                   TextWrapping="Wrap"
                                                                   MaxWidth="80"/>
                                                </StackPanel>
                                        </Button>
                                </StackPanel>
                        </ScrollViewer>
                </Border>

                <!-- ÁREA DE CONTEÚDO -->
                <Border Grid.Row="2"
                        Background="White">
                        <ContentControl x:Name="ContentArea"
                                        Margin="0"/>
                </Border>

                <!-- Rodapé -->
                <Border Grid.Row="3"
                                Background="#2C3E50">
                        <Grid Margin="15,0">
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                                x:Name="TxtUsuario"
                                                Foreground="White"
                                           VerticalAlignment="Center"
                                                FontSize="11"/>
                                <TextBlock Grid.Column="1"
                                                x:Name="TxtBanco"
                                                Text="Banco: Conectado"
                                           Foreground="#2ECC71"
                                                VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                                FontSize="11"/>
                                <TextBlock Grid.Column="2"
                                                Text="Versão: 1.0.0"
                                                Foreground="White"
                                           VerticalAlignment="Center"
                                                HorizontalAlignment="Right"
                                                FontSize="11"/>
                        </Grid>
                </Border>
        </Grid>
</Window>