<Window x:Class="SgaAutoEletrica.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SGA - Sistema de Gestão para Autoelétrica" 
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Menu Lateral -->
        <Border Grid.Column="0" Background="#2C3E50">
            <StackPanel Margin="10">
                <TextBlock Text="SGA" FontSize="24" FontWeight="Bold" 
                           Foreground="White" Margin="0,10,0,30" HorizontalAlignment="Center"/>
                
                <Button Content="Dashboard" 
                        Click="BtnDashboard_Click"
                        Style="{StaticResource MenuButtonStyle}" Margin="0,2"/>
                
                <Button Content="Clientes" 
                        Click="BtnClientes_Click"
                        Style="{StaticResource MenuButtonStyle}" Margin="0,2"/>
                
                <Button Content="Veículos" 
                        Click="BtnVeiculos_Click"
                        Style="{StaticResource MenuButtonStyle}" Margin="0,2"/>
                
                <Button Content="Peças" 
                        Click="BtnPecas_Click"
                        Style="{StaticResource MenuButtonStyle}" Margin="0,2"/>
                
                <Button Content="Serviços" 
                        Click="BtnServicos_Click"
                        Style="{StaticResource MenuButtonStyle}" Margin="0,2"/>
                
                <Button Content="Fornecedores" 
                        Click="BtnFornecedores_Click"
                        Style="{StaticResource MenuButtonStyle}" Margin="0,2"/>
                
                <Button Content="Ordens de Serviço" 
                        Click="BtnOS_Click"
                        Style="{StaticResource MenuButtonStyle}" Margin="0,2"/>
            </StackPanel>
        </Border>

        <!-- Conteúdo Principal -->
        <Border Grid.Column="1" Background="#ECF0F1">
            <ContentControl x:Name="ContentArea" Margin="10"/>
        </Border>
    </Grid>
</Window>