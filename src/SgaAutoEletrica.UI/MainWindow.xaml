<Window x:Class="SgaAutoEletrica.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SgaAutoEletrica.UI.ViewModels"
        Title="SGA - Sistema de Gestão para Autoelétrica" 
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Menu Lateral -->
        <Border Grid.Column="0" Background="#2C3E50">
            <StackPanel Margin="10">
                <TextBlock Text="SGA" FontSize="24" FontWeight="Bold" 
                           Foreground="White" Margin="0,10,0,30" HorizontalAlignment="Center"/>
                
                <Button Content="Dashboard" 
                        Command="{Binding NavegarDashboardCommand}"
                        Style="{StaticResource MenuButtonStyle}" Margin="0,2"/>
                
                <Button Content="Clientes" 
                        Command="{Binding NavegarClientesCommand}"
                        Style="{StaticResource MenuButtonStyle}" Margin="0,2"/>
                
                <Button Content="Veículos" 
                        Command="{Binding NavegarVeiculosCommand}"
                        Style="{StaticResource MenuButtonStyle}" Margin="0,2"/>
                
                <Button Content="Peças" 
                        Command="{Binding NavegarPecasCommand}"
                        Style="{StaticResource MenuButtonStyle}" Margin="0,2"/>
                
                <Button Content="Serviços" 
                        Command="{Binding NavegarServicosCommand}"
                        Style="{StaticResource MenuButtonStyle}" Margin="0,2"/>
                
                <Button Content="Fornecedores" 
                        Command="{Binding NavegarFornecedoresCommand}"
                        Style="{StaticResource MenuButtonStyle}" Margin="0,2"/>
                
                <Button Content="Ordens de Serviço" 
                        Command="{Binding NavegarOrdensServicoCommand}"
                        Style="{StaticResource MenuButtonStyle}" Margin="0,2"/>
            </StackPanel>
        </Border>

        <!-- Conteúdo Principal -->
        <Border Grid.Column="1" Background="#ECF0F1">
            <Grid Margin="20">
                <TextBlock Text="{Binding CurrentView}" 
                           FontSize="32" FontWeight="Bold"
                           Foreground="#2C3E50"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>